{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(ls *)", "Bash(wc *)", "Bash(pwd)", "Bash(node *)", "Bash(npx esbuild *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(.claude/mom-ask.sh *)"
    ],
    "deny": [
      "Bash(sudo *)", "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(rm -fr /*)",
      "Bash(git push*)", "Bash(git reset --hard*)", "Bash(git clean*)", "Bash(git stash*)",
      "Bash(git rebase*)", "Bash(git merge *)", "Bash(git branch -D*)", "Bash(git tag -d*)", "Bash(git remote*)",
      "Bash(killall *)", "Bash(pkill *)", "Bash(launchctl *)", "Bash(defaults write*)", "Bash(security *)",
      "Bash(printenv*)", "Bash(env)", "Bash(curl *)", "Bash(wget *)", "Bash(brew *)", "Bash(pip *)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(.env)", "Read(.env.*)",
      "Edit(spec/**)", "Edit(.claude/**)", "Edit(~/.claude/**)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/mom.sh", "timeout": 90, "statusMessage": "Asking mom (Opus judge)…" } ] }
    ]
  }
}
