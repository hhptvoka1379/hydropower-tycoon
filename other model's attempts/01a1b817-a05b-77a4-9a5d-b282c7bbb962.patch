+  s.pendingMoney += Math.max(0,CONFIG.reserve.minCallPrice-state.market.priceNow)*delivered*dt/3600;
+  if (call.elapsed>=call.duration) {
+    const success=call.passed===true && !call.failedHold;
+    if (call.emergency) {
+      s.reliability=scoreAfter(s.reliability,success?'emergencySuccess':'emergencyFailure');
+      if (success) s.successfulEmergencies++;
+    }
+    else {
+      s.reliability=scoreAfter(s.reliability,success?'callSuccess':'callFailure');
+      if (success) { s.answeredCalls++; s.consecutiveCalls++; }
+      else { s.consecutiveCalls=0; s.pendingMoney+=failedCapacityAdjustment(call.payment); }
+    }
+    restore(state,call); s.activeCall=null;
+  }
+}
+export function reserveSettlement(ctx) {
+  const s=initServices(ctx.state);
+  if (s.hour) ctx.services += s.hour.payment;
+  ctx.services += s.pendingMoney; s.pendingMoney=0;
+}
+
+// Daily emergency rolls use the events stream (§9.4). The start hour is chosen
+// uniformly among hours that leave room for the complete emergency that day.
+export function scheduleEmergency(state) {
+  const s=initServices(state), c=state.clock;
+  if (s.lastEmergencyRollDay===c.day) return;
+  s.lastEmergencyRollDay=c.day;
+  const current=(c.day-1)*24+c.hour;
+  if (state.market.emergency && state.market.emergency.endHour>current) return;
+  state.market.emergency=null;
+  if (nextFloat(state.rng,'events')>=CONFIG.reserve.emergencyChance) return;
+  const cfg=CONFIG.reserve;
+  const duration=cfg.emergencyMinHours+Math.floor(nextFloat(state.rng,'events')*(cfg.emergencyMaxHours-cfg.emergencyMinHours+1));
+  const first=Math.min(c.hour, CONFIG.time.hoursPerDay-duration);
+  const start=first+Math.floor(nextFloat(state.rng,'events')*(CONFIG.time.hoursPerDay-duration-first+1));
+  const startHour=(c.day-1)*24+start;
+  state.market.emergency={startHour,endHour:startHour+duration,started:false};
+}
+export function reserveBeginStep({state}) { scheduleEmergency(state); }
diff --git a/src/sim/sites.js b/src/sim/sites.js
new file mode 100644
index 0000000..da55130
--- /dev/null
+++ b/src/sim/sites.js
@@ -0,0 +1,50 @@
+// Minimal site helpers for the engine (§11.2). Site ownership rules belong to Gameplay.
+import { createInitialState } from '../state.js';
+import { CONFIG } from '../config.js';
+import { generateCanyon, applyCanyonToSite } from './canyon.js';
+import { riverBase, riverRain } from './climate.js';
+
+// The state contract exposes a complete Classic site through its initial state.
+// This returns a detached site; Gameplay decides whether and when to add it.
+export function createSite(seed, id) {
+  if (!Number.isInteger(id) || id < 0) throw new Error('invalid site id');
+  const site = createInitialState(seed).sites[0];
+  site.id = id;
+  return site;
+}
+
+export function getSite(state, id) {
+  return state.sites.find(site => site.id === id) ?? null;
+}
+
+export function forEachSite(state, fn) {
+  state.sites.forEach(fn);
+}
+
+// §9.6 purchases return undefined for unrelated actions.
+export function siteAction(state, action) {
+  if (action.type !== 'BUY_SITE') return undefined;
+  const n=state.sites.length, cfg=CONFIG.multisite;
+  if (n >= cfg.maxSites) return {ok:false,reason:'maximum sites owned'};
+  if (n===1 && (state.services.answeredCalls || 0)<cfg.callsForSecond) return {ok:false,reason:'five successful reserve calls required'};
+  if (n===2 && state.clock.day-(state.sites[1].ownedSince ?? state.clock.day)<cfg.thirdWaitDays) return {ok:false,reason:'second site must be owned for 90 days'};
+  const cost=n===1 ? cfg.secondPrice : cfg.thirdPrice;
+  if (state.finance.cash<cost) return {ok:false,reason:'insufficient cash'};
+  const rng={...state.rng}, generated=generateCanyon(rng);
+  if (!generated) return {ok:false,reason:'no valid canyon generated'};
+  const id=Math.max(...state.sites.map(s=>s.id))+1;
+  const site=createSite(state.seed,id);
+  site.turbines=[]; site.pumps=[]; site.arrays=[]; site.windTurbines=[]; site.batteries=[];
+  site.ownedSince=state.clock.day; site.purchasePrice=cost;
+  applyCanyonToSite(site,generated.terrain,generated.xDam);
+  state.rng.terrain=rng.terrain;
+  state.finance.cash-=cost; state.sites.push(site);
+  // Add the new site's current-hour inflow without re-drawing or updating the
+  // existing sites' hourly snow. The remaining hour alone enters its snowpack.
+  const wx=state.climate.current, hold=wx.snowHoldFrac || 0;
+  const rain=riverRain(wx.P_rain,wx.stormRunoffMult>1);
+  const left=CONFIG.time.secondsPerHour-state.clock.secondsIntoHour;
+  state.climate.snowpack.sites[site.id]={stored:hold*rain*left,releaseRate:0,releaseDay:0};
+  wx.Q_river.push(riverBase(site,state.clock.day,state.climate)+rain*(1-hold));
+  return {ok:true,cost,siteId:id};
+}
