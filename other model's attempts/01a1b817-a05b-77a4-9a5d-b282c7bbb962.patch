+// Battery energy, power and capacity fade (§9.3). MWh, W, seconds, dollars.
+import { CONFIG } from '../config.js';
+
+export function createBattery(id, tier, parcel, tile) {
+  const spec = CONFIG.battery.tiers[tier];
+  if (!spec) throw new Error('invalid battery tier');
+  return { id, tier, parcel, tile, P_rated: spec.powerMW * CONFIG.energy.wPerMW, capacityMWh: spec.energyMWh,
+    energyMWh: spec.energyMWh * CONFIG.battery.minSoc, target: 0, manualTarget: 0,
+    P_ch: 0, P_dis: 0, cycles: 0, refurbishSeconds: 0 };
+}
+export function batteryCost(tier) { return CONFIG.battery.tiers[tier].basePrice * CONFIG.CAPEX_SCALE; }
+export function refurbishCost(tier) { return batteryCost(tier) * CONFIG.battery.refurbishFraction; }
+export function stateOfCharge(b) { return b.capacityMWh > 0 ? b.energyMWh / b.capacityMWh : 0; }
+
+// Signed target −1..1: negative charges, positive discharges. §9.3 η = √RTE.
+export function stepBattery(b, dt) {
+  const spec = CONFIG.battery.tiers[b.tier], cfg = CONFIG.battery;
+  const eta = Math.sqrt(cfg.roundTrip), hours = dt / CONFIG.time.secondsPerHour;
+  b.P_ch = 0; b.P_dis = 0;
+  if (!(hours > 0)) return { P_bat_ch: 0, P_bat_dis: 0 };
+  if (b.refurbishSeconds > 0) {
+    b.refurbishSeconds = Math.max(0, b.refurbishSeconds - dt);
+    if (b.refurbishSeconds === 0) {
+      const soc = stateOfCharge(b);
+      b.capacityMWh = spec.energyMWh; b.energyMWh = soc * b.capacityMWh; b.cycles = 0;
+    }
+    return { P_bat_ch: 0, P_bat_dis: 0 };
+  }
+  const target = Math.max(-1, Math.min(1, b.target));
+  if (target < 0) {
+    const imported = Math.min(-target * spec.powerMW * hours,
+      Math.max(0, cfg.maxSoc * b.capacityMWh - b.energyMWh) / eta);
+    b.energyMWh += imported * eta;
+    b.P_ch = imported / hours * CONFIG.energy.wPerMW;
+  } else if (target > 0) {
+    const withdrawn = Math.min(target * spec.powerMW * hours / eta,
+      Math.max(0, b.energyMWh - cfg.minSoc * b.capacityMWh));
+    b.energyMWh -= withdrawn;
+    b.P_dis = withdrawn * eta / hours * CONFIG.energy.wPerMW;
+    // Equivalent full cycles count energy withdrawn from the cell (§9.3).
+    b.cycles += withdrawn / spec.energyMWh;
+    b.capacityMWh = Math.max(0, spec.energyMWh * (1 - cfg.fadePerCycle * b.cycles));
+    b.energyMWh = Math.max(cfg.minSoc * b.capacityMWh, Math.min(cfg.maxSoc * b.capacityMWh, b.energyMWh));
+  }
+  return { P_bat_ch: b.P_ch, P_bat_dis: b.P_dis };
+}
+
+// §9.3 one-way conversion and linear equivalent-full-cycle fade.
+export function chargeStored(energyMWh) { return energyMWh * Math.sqrt(CONFIG.battery.roundTrip); }
+export function dischargeDelivered(energyMWh) { return energyMWh * Math.sqrt(CONFIG.battery.roundTrip); }
+export function capacityAfterCycles(tier, cycles) {
+  return Math.max(0, CONFIG.battery.tiers[tier].energyMWh * (1 - CONFIG.battery.fadePerCycle * cycles));
+}
+
+// Return undefined for actions belonging to the engine or another gameplay module.
+export function batteryAction(state, action) {
+  const isBuild = action.type === 'BUILD' && action.kind === 'battery';
+  const isBattery = action.batteryId !== undefined && (action.type === 'SET_FLOW' || action.type === 'REPAIR');
+  if (!isBuild && !isBattery) return undefined;
+  const site = state.sites.find(s => s.id === (action.siteId ?? 0));
+  if (!site) return { ok: false, reason: 'no such site' };
+  if (isBuild) {
+    const spec = CONFIG.battery.tiers[action.tier];
+    if (!Number.isInteger(action.tier) || !spec) return { ok: false, reason: 'invalid battery tier' };
+    if (!site.parcels.some(p => p.id === action.parcel && p.owned)) return { ok: false, reason: 'parcel not owned' };
+    if (!Number.isInteger(action.tile) || action.tile < 0 || action.tile >= CONFIG.parcels.nTiles) return { ok: false, reason: 'invalid tile' };
+    if (site.batteries.some(b => b.parcel === action.parcel && b.tile === action.tile)) return { ok: false, reason: 'battery tile occupied' };
+    const cost = batteryCost(action.tier);
+    if (state.finance.cash < cost) return { ok: false, reason: 'insufficient cash; take a loan first' };
+    const id = Math.max(0, ...site.batteries.map(b => b.id)) + 1;
+    site.batteries.push(createBattery(id, action.tier, action.parcel, action.tile));
