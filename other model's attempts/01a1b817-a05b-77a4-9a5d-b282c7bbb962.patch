+    Q_max: c.Q_max,
+    Q_des: CONFIG.turbineQdesFrac * c.Q_max,           // Q_des = 0.9·Q_max (§2.4, §2.5)
+    etaRated: isPump ? c.eta_p : c.eta_t,
