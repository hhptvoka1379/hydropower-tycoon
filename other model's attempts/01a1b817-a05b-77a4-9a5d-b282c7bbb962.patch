+// Repair (§4.4): Cost = (100 − h)·0.25%·CapEx_unit, Downtime = (100 − h)·0.2 h
+function unitCapex(kind, tier) {
+  const cat = kind === 'pump' ? CONFIG.pumps : CONFIG.turbines;
+  return (cat[tier] ? cat[tier].basePrice : 0) * CONFIG.CAPEX_SCALE;
