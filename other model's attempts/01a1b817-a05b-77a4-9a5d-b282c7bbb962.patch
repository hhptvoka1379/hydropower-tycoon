@@ -0,0 +1,9 @@
+// §10.2 rolling hourly telemetry, sampled from the same state as settlement.
+export function telemetryHourly({state,price}) {
+  const c=state.clock,hour=(c.hour+23)%24,day=c.hour===0?c.day-1:c.day;
+  const sites=state.sites.map(s=>({id:s.id,upper:s.reservoirs.upper.V,lower:s.reservoirs.lower.V,
+    generation:s.live?.P_gen||0,pumping:s.live?.P_pump||0,renewables:(s.live?.P_solar||0)+(s.live?.P_wind||0),
+    battery:s.batteries.reduce((n,b)=>n+(b.P_dis||0)-(b.P_ch||0),0)}));
+  state.stats.history.push({day,hour,price,sites});
+  if(state.stats.history.length>24)state.stats.history.splice(0,state.stats.history.length-24);
+}
