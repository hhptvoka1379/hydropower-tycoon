+// Hour boundary: publish the current hour's climate into state.climate.current, including river and
+// melt inflows and snowpack hold/release (§5.2). Sites use current.Q_river[siteIndex].
+function updateHour(state) {
+  const cl = state.climate, D = state.clock.day, h = state.clock.hour;
+  const rec = dayRecord(state, D);
+  if (!rec) return state;
+  const x = rec.hours[h];
+  const evs = eventsOn(cl, D);
+  cl.activeEvents = evs.map(e => ({ type: e.type, start: e.start, end: e.end }));
+  const cold = evs.some(e => e.type === 'coldSnap');
+  const sRain = evs.some(e => e.type === 'stormRain');
+  // §5.2: snow retained at each river is released only into that river.
+  // Migrate an older single-site snapshot to its first procedural site.
+  if (!cl.snowpack.sites) {
+    const old = cl.snowpack;
+    cl.snowpack = { sites: {} };
+    const first = state.sites.find(site => site.kind !== 'classic');
+    if (first) cl.snowpack.sites[first.id] = { stored: old.stored || 0, releaseRate: old.releaseRate || 0, releaseDay: old.releaseDay || 0 };
+  }
+  const holdFrac = cold ? EV().coldSnap.snowpackFrac : 0;
+  const Q_river = state.sites.map(site => {
+    if (site.kind === 'classic') return 0; // §3.2: Classic has no river.
+    const sp = cl.snowpack.sites[site.id] ||= { stored: 0, releaseRate: 0, releaseDay: 0 };
+    if (sp.releaseDay !== D) {
+      if (!cold && rec.mean.T > EV().coldSnap.meltAboveC && sp.stored > 0) {
+        sp.releaseRate = sp.stored / 86400; sp.stored = 0; sp.releaseDay = D;
+      } else sp.releaseRate = 0;
+    }
+    let qr = riverRain(x.P_rain, sRain);
+    if (holdFrac > 0) { sp.stored += holdFrac * qr * 3600; qr *= 1 - holdFrac; }
