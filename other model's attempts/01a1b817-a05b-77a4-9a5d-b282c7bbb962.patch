+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+const css=readFileSync('src/style.css','utf8');
+function variables(block){return Object.fromEntries([...block.matchAll(/--([\w-]+):(#(?:[\da-f]{8}|[\da-f]{6}))/gi)].map(m=>[m[1],m[2]]));}
+const themes=[['field',variables(css.match(/:root\{([^}]+)\}/)[1])],...['brass','dusk'].map(name=>[name,variables(css.match(new RegExp(`\\[data-theme=${name}\\]\\{([^}]+)\\}`))[1])])];
+function rgb(hex){hex=hex.slice(1);return [0,2,4].map(i=>parseInt(hex.slice(i,i+2),16)/255);}
+function luminance(hex){const [r,g,b]=rgb(hex).map(v=>v<=0.04045?v/12.92:((v+0.055)/1.055)**2.4);return .2126*r+.7152*g+.0722*b;}
+function ratio(a,b){const x=luminance(a),y=luminance(b);return (Math.max(x,y)+0.05)/(Math.min(x,y)+0.05);}
+for(const [name,t] of themes)for(const surface of ['surface','raised'])for(const ink of ['ink','muted','gen','pump','ren','warn','alarm']){const value=ratio(t[surface],t[ink]);assert.ok(value>=4.5,`${name} ${ink}/${surface} ${value.toFixed(2)} < 4.5`);}
+console.log('contrast: semantic text tokens on opaque theme surfaces meet 4.5:1; translucent compositing and actual UI rendering not verified');
