diff --git a/tests/run-all.mjs b/tests/run-all.mjs
new file mode 100644
index 0000000..cae8b4c
--- /dev/null
+++ b/tests/run-all.mjs
@@ -0,0 +1,12 @@
+// Dependency-free repository checks, including the bundled worker audit.
+import { readdirSync } from 'node:fs';
+import { spawnSync } from 'node:child_process';
+
+const tests=readdirSync('tests').filter(name=>name.endsWith('.test.mjs')||name.endsWith('-smoke.mjs')).sort().map(name=>'tests/'+name);
+const checks=[['build/bundle.mjs'],['tools/contract-check.mjs'],['build/bundle.mjs','--check'],...tests.map(test=>[test]),['tests/selftest-cli.mjs']];
+for(const args of checks){
+  const result=spawnSync(process.execPath,args,{encoding:'utf8',maxBuffer:16*1024*1024});
+  if(result.status!==0){console.error(`FAIL ${args.join(' ')}`);console.error(result.stdout||'');console.error(result.stderr||result.error||'');process.exit(result.status||1);}
+  const last=result.stdout.trim().split('\n').at(-1);
+  console.log(`PASS ${args.join(' ')}${last?' — '+last:''}`);
+}
