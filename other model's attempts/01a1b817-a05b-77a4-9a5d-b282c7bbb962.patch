+
+Object.assign(exports,{"thomaSigma":thomaSigma,"turbineSuctionHead":turbineSuctionHead,"npshAvailable":npshAvailable,"cavitationPenalty":cavitationPenalty,"wearDelta":wearDelta,"etaMult":etaMult,"isTripped":isTripped,"unitCapex":unitCapex,"repairCost":repairCost,"repairHours":repairHours,"healthOf":healthOf,"setHealth":setHealth});
