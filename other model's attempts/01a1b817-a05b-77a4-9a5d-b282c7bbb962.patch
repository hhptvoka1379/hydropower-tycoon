+  } catch (e) { return {ok:false,reason:'invalid save: '+e.message}; }
+}
+export function saveToSlot(state,actionLog=[],settings=createDefaultSettings(),slot='default',worldOptions=null,pendingActions=null) {
+  if (!validSlot(slot)) return {ok:false,reason:'invalid slot'};
+  try {
+    const text=serializeSave(state,actionLog,settings,worldOptions,pendingActions), key=keyFor(slot);
+    memory.set(key,text);
+    try { globalThis.localStorage.setItem(key,text); return {ok:true,persistent:true,text}; }
+    catch { return {ok:true,persistent:false,text}; }
+  } catch (e) { return {ok:false,reason:e.message}; }
+}
+export function loadFromSlot(slot='default') {
+  if (!validSlot(slot)) return {ok:false,reason:'invalid slot'};
+  const key=keyFor(slot); let text=null;
+  try { text=globalThis.localStorage.getItem(key); } catch { /* memory fallback */ }
+  text ??= memory.get(key) ?? null;
+  return text===null ? {ok:false,reason:'no save in slot'} : parseSave(text);
+}
+
+// Replay the ordered tick/action log against the same fixed-step engine (§11.5).
+export function replay(seed, actionLog, endTick, worldOptions={kind:'classic'}) {
+  if (!Array.isArray(actionLog) || !Number.isInteger(endTick) || endTick<0) throw new Error('invalid replay');
+  const state=createInitialState(seed);
+  if (worldOptions.kind==='procedural') {const canyon=generateCanyon(state.rng,worldOptions.terrain||{});if(!canyon)throw new Error('replay canyon generation failed');applyCanyonToSite(state.sites[0],canyon.terrain,worldOptions.station??canyon.xDam);}
+  else if(worldOptions.kind!=='classic')throw new Error('invalid replay world');
+  if(worldOptions.demo){state.finance.demo=true;state.finance.sandbox=true;state.finance.cash=1e15;state.quests.sandbox=true;}
+  const engine=installGameplay(createEngine(state),state);
+  let i=0, previous=-1;
+  for (const item of actionLog) {
+    if (!Number.isInteger(item.tick) || item.tick<previous || item.tick>endTick || !item.action) throw new Error('invalid action log');
+    previous=item.tick;
+  }
+  while (state.clock.tick<endTick) {
+    while (i<actionLog.length && actionLog[i].tick===state.clock.tick) {
+      const result=engine.dispatch(actionLog[i++].action);
+      if (!result.ok) throw new Error('replay action rejected: '+result.reason);
+    }
+    engine.flushActions();
+    engine.step(CONFIG.time.speeds[state.clock.speedIndex].dt);
+  }
+  while (i<actionLog.length && actionLog[i].tick===endTick) {
+    const result=engine.dispatch(actionLog[i++].action);
+    if (!result.ok) throw new Error('replay action rejected: '+result.reason);
+  }
+  return engine;
+}
