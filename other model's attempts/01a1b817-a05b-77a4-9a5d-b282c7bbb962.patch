+
+// §5.1 daily cloud draw: clamp(mean + 0.2(2·rng − 1), 0, 1)
+function drawCloud(rng, D) {
+  const mean = CONFIG.climateSeasons[seasonIndex(D)].cloud;
+  return clamp(mean + C().cloudSpread * (2 * nextFloat(rng, 'weather') - 1), 0, 1);
