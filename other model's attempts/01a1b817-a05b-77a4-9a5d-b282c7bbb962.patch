+"src/sim/alerts.js":function(exports,__require){
+// Alerts are episode-deduplicated; resolving a condition permits a later alert (§9.9).
+function episode(state,key,active,alert) {
+  const live=state.stats.alertEpisodes ??= {};
+  if (active && !live[key]) {
+    live[key]=true;
+    state.alerts.push({ ...alert, day:state.clock.day, hour:state.clock.hour, tick:state.clock.tick });
+  } else if (!active) delete live[key];
+}
+function alertsAfterSite({state,site,plant,water}) {
+  const id=site.id;
+  episode(state,`soil:${id}`,site.arrays.some(a=>a.f_soil<0.75),{type:'panels_dirty',severity:'warning',siteId:id});
+  episode(state,`repair:${id}`,[...site.turbines,...site.pumps].some(u=>u.wear>0.7),{type:'repair_due',severity:'warning',siteId:id});
+  episode(state,`spill:${id}`,water.S_lower>0,{type:'overflow',severity:'danger',siteId:id});
+  episode(state,`env:${id}`,water.envUnmet>0,{type:'environment_unmet',severity:'danger',siteId:id});
+  episode(state,`lowre:${id}`,plant.lowRe,{type:'low_reynolds',severity:'warning',siteId:id});
+  for (const x of plant.alerts) episode(state,`${x.type}:${id}:${x.unitId ?? ''}`,true,{...x,severity:'warning',siteId:id});
+  for (const k of Object.keys(state.stats.alertEpisodes || {})) {
+    if (!k.startsWith('cavitation_margin:'+id+':') && !k.startsWith('trip:'+id+':') && !k.startsWith('interlock_pump:'+id+':') && !k.startsWith('interlock_gen:'+id+':')) continue;
+    const still=plant.alerts.some(a=>`${a.type}:${id}:${a.unitId ?? ''}`===k);
+    if (!still) delete state.stats.alertEpisodes[k];
+  }
+}
+function alertsHourly({state}) {
+  episode(state,'emergency-loan',!!state.finance.emergencyLoan,{type:'bankruptcy_warning',severity:'danger'});
+  const available=state.sites.length===1 && (state.services.answeredCalls||0)>=5;
+  episode(state,'site-for-sale',available,{type:'site_for_sale',severity:'info'});
+  const tomorrow=state.climate.days.find(d=>d.day===state.clock.day+1);
+  if (!tomorrow) return;
+  for (const type of ['heatWave','coldSnap','windstorm','stormRain']) {
+    const key=`forecast:${tomorrow.day}:${type}`;
+    episode(state,key,tomorrow.events.includes(type),{type:'weather_forecast',event:type,forecastDay:tomorrow.day,severity:'info'});
+  }
+  const episodes=state.stats.alertEpisodes || {};
+  for (const key of Object.keys(episodes)) if (key.startsWith('forecast:') && !key.startsWith(`forecast:${tomorrow.day}:`)) delete episodes[key];
+}
+
+Object.assign(exports,{"alertsAfterSite":alertsAfterSite,"alertsHourly":alertsHourly});
+},
+"src/sim/quests.js":function(exports,__require){
+// Progression and grants (§9.8). Rewards are charged dollars, not base prices.
+const {CONFIG}=__require("src/config.js");
+const {netPower, outstandingPrincipal, solarStcW}=__require("src/sim/economy.js");
+const {windRated}=__require("src/sim/renewables.js");
+const {ownedEquipmentPrice}=__require("src/sim/construction.js");
