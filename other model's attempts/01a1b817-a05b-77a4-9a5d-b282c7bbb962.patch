+import { previewRenewableInvestment } from './sim/investment.js';
+import { environmentalFlow } from './sim/environment.js';
+import { reserveRequirement, capacityPrice } from './sim/services.js';
+import { effectivePrice } from './sim/market.js';
+import { layoutFactors, solarPower } from './sim/renewables.js';
+
+export function createGame(seed = 12345) {
