+export function damageBeforeStep({state}) {
+  const day=state.clock.day;
+  const storm=state.climate.activeEvents.some(e=>e.type==='windstorm');
+  for (const site of state.sites) {
+    if (site.windDamageDay!==day) {
+      site.windDamageDay=day;
+      if (storm) for (const w of site.windTurbines) {
+        if (!w.damaged && bladeDamaged(state.seed,day,`${site.id}:${w.id}`)) {
+          w.damaged=true; w.offline=true;
+          state.alerts.push({type:'wind_damage',siteId:site.id,unitId:w.id,severity:'danger',day,hour:state.clock.hour});
+        }
+      }
+    }
+    const manager=state.automation.enabled!==false&&state.automation.manager?.enabled?state.automation.manager:null;
+    const reserve=Math.max(state.automation.repairCashReserve ?? 0,manager?(manager.cashReserve??0)+(manager.pendingCost??0):0);
+    for (const w of site.windTurbines) if (w.damaged && !site.jobs.some(j=>j.type==='wind_repair' && j.windId===w.id)) {
+      const cost=CONFIG.events.windstorm.repairCost;
+      if (state.finance.cash-cost<reserve) continue;
+      state.finance.cash-=cost;
+      site.jobs.push({type:'wind_repair',windId:w.id,cost,secondsLeft:CONFIG.events.windstorm.offlineH*3600});
+    }
+  }
+}
+// Construction owns the common job clock; restore the turbine just before its
+// completed job is removed by advanceJobs.
+// A cracked dam remains usable; the safe depth is a warning rather than an
+// artificial spill. Damage accumulates only while water is above the crack.
+export function damDamageAfterSite({state,site,water,dt}) {
+  const dam=site.dam,cfg=CONFIG.damDamage,storm=state.climate.activeEvents.some(e=>e.type==='stormRain');
+  const height=site.kind==='procedural'?dam.H_dam:dam.H_gross;
+  const limit=site.kind==='procedural'?CONFIG.dam.classMaxHdam[dam.class]:CONFIG.dam.classMaxGrossHead[dam.class];
+  const qualifying=storm && (water.S_upper>0 || water.S_lower>0) && height>cfg.classLimitFraction*limit;
+  if (!dam.crack && qualifying && dam.lastFloodRollDay!==state.clock.day) {
+    dam.lastFloodRollDay=state.clock.day;
+    if(nextFloat(state.rng,'events')<cfg.floodChancePerDay) {
+      const depth=site.reservoirs.upper.D_max*(1-cfg.crackTopFraction*nextFloat(state.rng,'events'));
