+// Runs the actual bundled worker branch in a VM. It verifies the message and
+// audit, but is not a substitute for a real browser Worker or WebGL.
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+import { performance } from 'node:perf_hooks';
+const html=readFileSync('hydropower-tycoon.html','utf8');
+const scripts=[...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].map(x=>x[1]);
+let message;const context={performance,structuredClone,console:{...console,table(){}},self:{postMessage:x=>message=x}};
+runInNewContext(scripts[1],context,{timeout:180000});
+assert.equal(message.allPassed,true);assert.equal(message.testResults.length,25);
+assert.equal(message.robustnessSweep.nanCount,0);assert.equal(message.robustnessSweep.violations,0);
+assert.equal(message.testResults.find(x=>x.id===24).pass,false);
+assert.ok(message.perf.stepMsAvg>0);
+console.log(`bundle worker smoke: ${message.testResults.length} rows, ${message.robustnessSweep.ticksRun} ticks, zero nonfinite, step ${message.perf.stepMsAvg.toFixed(4)} ms/site PASS; pacing remains report-only`);
