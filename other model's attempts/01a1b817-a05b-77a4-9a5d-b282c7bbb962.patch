+      let cost = 0, commit;
+      if (action.type === 'REPLACE_PENSTOCK') {
+        const { D, material } = action;
+        if (!CONFIG.penstock.diameters.includes(D) || !Object.hasOwn(CONFIG.penstock.roughness, material)) return fail('invalid penstock');
+        cost = construction.penstockPrice(D, site.penstock.L, material);
