+    if (!result.ok) return result;
+    try {
+      const next=installGameplay(createEngine(result.state),result.state,{restoreManagerPending:result.pendingActions===undefined});
+      if(result.pendingActions)for(const action of result.pendingActions)next.dispatch(action);
+      state=result.state; engine=next; settings=result.settings; worldOptions=result.worldOptions; seed=state.seed;
+      actionLog.splice(0,actionLog.length,...result.actionLog);
+      snapshot=engine.getSnapshot(); autosaveDay=snapshot.clock.day; carry=0; last=null; error=null;
+      return {ok:true};
+    } catch (e) { return {ok:false,reason:'invalid saved state: '+e.message}; }
+  }
+  function tick(now) {
+    if (!running) return;
+    try {
+      for (const result of engine.flushActions()) if (!result.ok) for (const fn of actionListeners) fn(result);
+      const clock = engine.getClock();
+      if (last !== null && !clock.paused && clock.mode === 'realtime') {
+        carry += Math.min(now - last, CONFIG.time.maxFrameRealMs) / 1000 * CONFIG.time.speeds[clock.speedIndex].gameSecPerRealSec;
+      }
+      last = now;
+      const start = performance.now();
+      let c = clock;
+      while (performance.now() - start < CONFIG.time.stepBudgetMsPerFrame) {
+        const dt = CONFIG.time.speeds[c.speedIndex].dt;
+        const turn = c.mode === 'turn' && c.turnRemaining > 0;
+        if (!turn && (c.paused || c.mode !== 'realtime' || carry < dt)) break;
+        const actual = engine.step(turn ? Math.min(dt, c.turnRemaining) : dt);
+        if (!turn) carry -= actual;
+        c = engine.getClock();
+      }
+      behind = c.mode === 'realtime' && !c.paused && carry >= CONFIG.time.speeds[c.speedIndex].dt;
