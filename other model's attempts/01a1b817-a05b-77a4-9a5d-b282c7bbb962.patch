+// CavitationPenalty = 10 if σ < σ_c (or NPSH_A < NPSH_R), else 0 (§4.1, §4.2)
+function cavitationPenalty(value, critical) {
+  return value !== null && value < critical ? W.cavitationPenalty : 0;
