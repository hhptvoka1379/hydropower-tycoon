+// §2.7 quasi-steady, single-penstock plant pipeline; no transient hydraulics.
+// Gameplay extends the pipeline via hooks; no gameplay behavior is fabricated here.
+import { CONFIG } from '../config.js';
+import { solvePlant } from './plant.js';
+import { stepReservoirs, catchmentArea, areaAt, penmanEvaporation } from './reservoirs.js';
+import * as climate from './climate.js';
+import * as market from './market.js';
+import * as renewables from './renewables.js';
+import * as economy from './economy.js';
+import * as construction from './construction.js';
+import { startProceduralRaise, applyCanyonToSite } from './canyon.js';
+import { getSite } from './sites.js';
+
+const phases = ['before-step', 'before-plant', 'after-plant', 'after-sites', 'before-settlement', 'hourly', 'daily'];
+const gameplayActions = ['BUY_PERMIT', 'BUY_SITE', 'SET_RESERVE_OFFER', 'SET_RULES', 'CLAIM_QUEST'];
+const knownActions = ['SET_SPEED', 'PAUSE', 'TURN_STEP', 'SET_FLOW', 'SET_MODE', 'SET_CURTAIL',
+  'PLACE_DAM', 'RAISE_DAM', 'EXCAVATE', 'BUILD', 'REPLACE_PENSTOCK', 'CLEAN_ARRAY',
+  'REPAIR', 'TAKE_LOAN', 'REPAY_LOAN', 'SIGN_CONTRACT', 'CONTINUE_SANDBOX', ...gameplayActions];
+const evap = m => penmanEvaporation(m.T, m.RH, m.u2, m.Rs);
+const copy = x => JSON.parse(JSON.stringify(x));
+// Canonical FNV-1a, kept local to satisfy the sim dependency rule (§11.5).
+function canonical(v) {
+  if (typeof v === 'number') return Number.isFinite(v) ? String(Number(v.toPrecision(12))) : 'null';
+  if (v === null || typeof v !== 'object') return JSON.stringify(v ?? null);
+  if (Array.isArray(v)) return '[' + v.map(canonical).join(',') + ']';
+  return '{' + Object.keys(v).sort().map(k => JSON.stringify(k) + ':' + canonical(v[k])).join(',') + '}';
+}
+function hash(v) {
+  const s = canonical(v); let h = 0x811c9dc5;
+  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
+  return h.toString(16).padStart(8, '0');
+}
+
+export function createEngine(state) {
+  const hooks = Object.fromEntries(phases.map(p => [p, []]));
+  const handlers = new Map(), queue = [];
+  if (!state.climate.days.length || !state.climate.ar) {
+    climate.initClimate(state, evap, market.priceDay);
+  }
+  for (const site of state.sites) site.catchmentArea ??= catchmentArea(site.reservoirs.lower);
+  function currentPrice() {
+    const i = climate.hourIndex(state.clock.day, state.clock.hour);
+    const record = state.market.prices.find(x => x.hourIndex === i);
+    const emergency = state.market.emergency;
+    return record && emergency && i >= emergency.startHour && i < emergency.endHour
+      ? { ...record, price: CONFIG.reserve.emergencyPrice } : record;
+  }
+  state.market.priceNow = currentPrice()?.price ?? 0;
+  function fire(phase, context) { for (const fn of hooks[phase]) fn(context); }
+  function fail(reason) { return { ok: false, reason }; }
+  function apply(action) {
+    const clock = state.clock;
+    if (handlers.has(action.type)) {
+      const handled = handlers.get(action.type)(state, action);
+      if (handled !== undefined) return handled; // Undefined delegates to the engine's own action.
+    }
+    if (gameplayActions.includes(action.type)) return fail('no handler registered for ' + action.type);
+    if (action.type === 'CONTINUE_SANDBOX') {
+      if (!state.finance.gameOver) return fail('sandbox continuation requires game over');
+      state.finance.gameOver=false;state.finance.sandbox=true;state.quests.sandbox=true;clock.paused=false;return {ok:true};
+    }
+    if (state.finance.gameOver && (action.type==='PAUSE' || action.type==='TURN_STEP')) return fail('game over; choose sandbox to continue');
+    if (action.type === 'SET_SPEED') {
+      if (!Number.isInteger(action.speedIndex) || !CONFIG.time.speeds[action.speedIndex]) return fail('invalid speed');
+      clock.speedIndex = action.speedIndex; return { ok: true };
+    }
+    if (action.type === 'PAUSE') { clock.paused = typeof action.paused === 'boolean' ? action.paused : !clock.paused; return { ok: true }; }
+    if (action.type === 'SET_MODE') {
+      if (!['realtime', 'turn'].includes(action.mode)) return fail('invalid clock mode');
+      clock.mode = action.mode; return { ok: true };
+    }
+    if (action.type === 'TURN_STEP') {
+      if (clock.mode !== 'turn') return fail('turn step requires turn mode');
+      clock.turnRemaining = (clock.turnRemaining || 0) + CONFIG.time.secondsPerHour; return { ok: true };
+    }
+    if (action.type === 'TAKE_LOAN') return economy.takeLoan(state, action.amount, action.months, clock.day);
+    if (action.type === 'REPAY_LOAN') return economy.repayLoan(state, action.index, action.amount);
+    if (action.type === 'SIGN_CONTRACT') return economy.signContract(state, action.id, clock.day);
+    const site = getSite(state, action.siteId ?? 0);
+    if (!site) return fail('no such site');
+    if (action.type === 'SET_FLOW') {
+      const unit = [...site.turbines, ...site.pumps].find(u => u.id === action.unitId);
+      if (!unit || !Number.isFinite(action.targetPct) || action.targetPct < 0 || action.targetPct > 1) return fail('invalid unit or flow');
+      unit.targetPct = action.targetPct; return { ok: true };
+    }
+    if (action.type === 'SET_CURTAIL') {
+      if (!['wind', 'solar'].includes(action.kind)) return fail('invalid curtailment');
+      if (action.fraction!==undefined) {
+        if (!Number.isFinite(action.fraction) || action.fraction<0 || action.fraction>1) return fail('invalid curtailment fraction');
+        const list=action.kind==='solar' ? site.arrays : site.windTurbines;
+        const unit=list.find(u=>u.id===action.unitId);
+        if (!unit) return fail('no such renewable unit');
+        unit.curtail=action.fraction; return {ok:true};
+      }
+      if (typeof action.curtailed!=='boolean') return fail('invalid curtailment');
+      site.curtail ??= {}; site.curtail[action.kind] = action.curtailed; return { ok: true };
+    }
+    // Equipment is bought immediately; charge only after all checks pass (§7.1).
+    if (action.type === 'BUILD' || action.type === 'REPLACE_PENSTOCK' || action.type === 'PLACE_DAM') {
+      let cost = 0, commit;
+      if (action.type === 'REPLACE_PENSTOCK') {
+        const { D, material } = action;
+        if (!CONFIG.penstock.diameters.includes(D) || !Object.hasOwn(CONFIG.penstock.roughness, material)) return fail('invalid penstock');
+        cost = construction.penstockPrice(D, site.penstock.L, material);
+        commit = () => { site.penstock = { ...site.penstock, D, material, epsilon: CONFIG.penstock.roughness[material] }; };
+      } else if (action.type === 'PLACE_DAM') {
+        const x = action.station;
+        if (!site.terrain || site.kind === 'procedural') return fail('site needs an unsited canyon');
+        if (!Number.isFinite(x) || x < CONFIG.canyon.xDamMin || x > CONFIG.canyon.xDamMax) return fail('invalid dam station');
+        // The initial procedural dam is free (§8.4); canyon builds its table.
+        commit = () => applyCanyonToSite(site, site.terrain, x);
+      } else {
+        const { kind, tier } = action;
+        if (kind === 'parcel') {
+          const parcel=action.parcel;
+          if (!Number.isInteger(parcel) || parcel<2 || parcel>=CONFIG.landParcelBasePrice.length) return fail('invalid parcel');
+          if (site.parcels.some(p=>p.id===parcel && p.owned)) return fail('parcel already owned');
+          cost=construction.parcelPrice(parcel);
+          commit=()=>{ site.parcels.push({id:parcel,owned:true}); site.capexGround=(site.capexGround || 0)+cost; };
+        } else if (!Number.isInteger(tier) || tier < 1) return fail('invalid tier');
+        else if (kind === 'pump' || kind === 'turbine') {
+          const list = kind === 'pump' ? site.pumps : site.turbines;
+          const specs = kind === 'pump' ? CONFIG.pumps : CONFIG.turbines;
+          if (!specs[tier]) return fail('invalid tier');
+          if (list.length >= 2) return fail('no free machine bay'); // §2.3: two bays per kind.
+          cost = kind === 'pump' ? construction.pumpPrice(tier) : construction.turbinePrice(tier);
+          const id = Math.max(0, ...site.pumps.map(u => u.id), ...site.turbines.map(u => u.id)) + 1;
+          commit = () => list.push({ id, kind, tier, targetPct: 0, openPct: 0, Q: 0, P: 0, wear: 0, running: false });
+        } else if (kind === 'wind' || kind === 'solar') {
+          const specs = kind === 'wind' ? CONFIG.wind.tiers : CONFIG.solar.modules;
+          if (!specs[tier]) return fail('invalid tier');
+          const parcel = action.parcel;
+          if (!site.parcels.some(p => p.id === parcel && p.owned)) return fail('parcel not owned');
+          const list = kind === 'wind' ? site.windTurbines : site.arrays;
+          const tile = action.tile;
+          if (!Number.isInteger(tile) || tile < 0 || tile >= CONFIG.parcels.nTiles) return fail('invalid tile');
+          if (list.some(u => u.parcel === parcel && u.tile === tile)) return fail('tile occupied');
+          cost = kind === 'wind' ? construction.windPrice(tier) : construction.solarPrice(tier);
+          const other=kind==='wind' ? site.arrays : site.windTurbines;
+          if (other.some(u=>u.parcel===parcel && u.tile===tile)) cost*=1-CONFIG.parcels.secondTechDiscount;
+          const id = Math.max(0, ...list.map(u => u.id)) + 1;
+          commit = kind === 'wind'
+            ? () => list.push({ id, tier, parcel, tile, purchasePrice:cost, P: 0, wear: 0 })
+            : () => list.push({ id, tier, parcel, tile, purchasePrice:cost, modules: CONFIG.solar.modules[tier], f_soil: CONFIG.soiling.max, cleaning: null, P: 0 });
+        } else return fail('unknown equipment kind');
+      }
+      if (cost > economy.availableBudget(state) || cost > state.finance.cash) return fail('insufficient cash; take a loan first');
+      try { commit(); } catch (e) { return fail('construction failed: ' + e.message); }
+      state.finance.cash -= cost;
+      return { ok: true, cost };
+    }
+    // Construction starters mutate state, so validate on a copy before charging (§7.1).
+    if (action.type==='RAISE_DAM' && action.class!==undefined) {
+      if (!Object.hasOwn(CONFIG.dam.classMaxGrossHead,action.class)) return fail('invalid dam class');
+      if (!state.finance.demo && action.class!=='gravity' && (!state.quests.archUnlocked || !state.stats.environment?.permit)) return fail('expansion quest and environmental permit required');
+    }
+    const start = target => {
+      if (action.type==='RAISE_DAM' && action.class!==undefined) target.dam.class=action.class;
+      if (action.type === 'RAISE_DAM' && !Number.isFinite(action.height)) return fail('invalid dam height');
+      if (action.type === 'RAISE_DAM') return target.kind === 'classic'
+        ? construction.startClassicRaise(target, action.height) : startProceduralRaise(target, action.height);
+      if (action.type === 'EXCAVATE') return construction.startExcavation(target, action.which);
+      if (action.type === 'CLEAN_ARRAY') return construction.startCleaning(target, action.arrayId);
+      if (action.type === 'REPAIR') {
+        const u = [...target.turbines, ...target.pumps].find(x => x.id === action.unitId);
+        return u ? construction.startRepair(target, u) : fail('no such unit');
+      }
+      return fail('action not implemented: ' + action.type);
+    };
+    let trial;
+    try { trial = start(copy(site)); } catch (e) { return fail('invalid action: ' + e.message); }
+    if (!trial.ok) return trial;
+    const cost = trial.job.cost;
+    if (!Number.isFinite(cost) || cost < 0 || cost > economy.availableBudget(state) || cost > state.finance.cash) return fail('insufficient cash; take a loan first');
+    const result = start(site); state.finance.cash -= cost;
+    if (action.type==='RAISE_DAM' || action.type==='EXCAVATE') {site.capexGround=(site.capexGround || 0)+cost;if(state.finance.demo){result.job.secondsLeft=0;construction.advanceJobs(site,0);result.instant=true;}}
+    return result;
+  }
+  function protectCash(before) {
+    const fin=state.finance;if(fin.demo){fin.cash=1e15;return;}
+    const a=state.automation;if(a.enabled!==false&&a.manager?.enabled&&a.manager.profitProtection!==false&&fin.cash<Math.max(0,before)){const floor=Math.max(0,before),grant=floor-fin.cash;fin.cash=floor;fin.godSubsidy=(fin.godSubsidy||0)+grant;fin.lifetime.revenue+=grant;}
+  }
+  function flushActions() {
+    const results = [];
+    while (queue.length) {
+      const action = queue.shift(), before=state.finance.cash; let result;
+      try { result = apply(action); } catch (e) { result = fail(e.message); }
+      protectCash(before);
+      const manager=state.automation.manager;if(manager?.pending && JSON.stringify(manager.pending)===JSON.stringify(action)){delete manager.pending;delete manager.pendingCost;}
+      if (!result.ok) state.alerts.push({ type: 'action_rejected', action: action.type, reason: result.reason });
+      results.push(result);
+    }
+    return results;
+  }
+  function dispatch(action) {
+    if (!action || typeof action !== 'object' || Array.isArray(action) || !knownActions.includes(action.type)) return fail('unknown action');
+    if (gameplayActions.includes(action.type) && !handlers.has(action.type)) return fail('no handler registered for ' + action.type);
+    try {
+      const cloned = copy(action);
+      if (!cloned || typeof cloned !== 'object' || Array.isArray(cloned) || cloned.type !== action.type) return fail('invalid serialized action');
+      queue.push(cloned);
+    } catch { return fail('action must be JSON-serializable'); }
+    return { ok: true, queued: true };
+  }
+  function step(dt) {
+    if (!Number.isFinite(dt) || dt <= 0) throw new Error('step dt must be positive and finite');
+    flushActions();
+    protectCash(0);
+    const cashBeforeStep=state.finance.cash;
+    const c = state.clock, actual = Math.min(dt, CONFIG.time.secondsPerHour - c.secondsIntoHour);
+    fire('before-step', { state, dt: actual });
+    const wx = state.climate.current, price = currentPrice();
+    state.market.priceNow = price?.price ?? 0;
+    const totals = { P_gen: 0, P_pump: 0, P_wind: 0, P_solar: 0, P_bat_dis: 0, P_bat_ch: 0, finedVolume: 0, lambda: price?.lambda ?? 0, dt: actual };
+    for (let i = 0; i < state.sites.length; i++) {
+      const site = state.sites[i];
+      site.catchmentArea ??= catchmentArea(site.reservoirs.lower);
+      // Valley runoff is stored per site; release over the first thaw day (§5.2).
+      const snow = site.valleySnow ??= { stored: 0, releaseRate: 0, day: 0 };
+      if (snow.day !== c.day) {
+        snow.day = c.day; snow.releaseRate = 0;
+        const record = climate.dayRecord(state, c.day);
+        if (!wx.snowHoldFrac && record && record.mean.T > CONFIG.events.coldSnap.meltAboveC && snow.stored > 0) {
+          snow.releaseRate = snow.stored / (CONFIG.time.hoursPerDay * CONFIG.time.secondsPerHour);
+          snow.stored = 0;
+        }
+      }
+      const renewable = renewables.updateSiteRenewables(site, wx);
+      const context = { state, site, dt: actual, weather: wx, totals, renewables: renewable };
+      fire('before-plant', context);
+      const plant = solvePlant(site, actual); // §2.7 plant includes wear (§4).
+      site.live = { ...plant, ...renewable };
+      const lower = site.reservoirs.lower;
+      const lakeArea = areaAt(lower, lower.d);
+      // §3.2: scale the land-only runoff without scaling rain directly on lakes.
+      const runoffScale = 1 - (wx.snowHoldFrac || 0);
+      const effectiveCatch = lakeArea + Math.max(0, site.catchmentArea - lakeArea) * runoffScale;
+      const base = climate.riverBase(site, c.day, state.climate);
+      const water = stepReservoirs(site.reservoirs.upper, lower, {
+        Q_up: plant.Q_up, P_rain: wx.P_rain, E_evap: wx.E,
+        A_catch: effectiveCatch, Q_river: site.kind === 'classic' ? 0 : wx.Q_river[i],
+        Q_river_base: base, dV_melt: (wx.Q_melt + snow.releaseRate) * actual, Q_env: context.Q_env || 0,
+      }, actual);
+      // §3.2 land runoff retained as snow enters this site's valley snowpack.
+      if (wx.snowHoldFrac > 0) {
+        const held = wx.P_rain / 1000 * Math.max(0, site.catchmentArea - lakeArea)
+          * CONFIG.reservoir.runoffCoef * actual / 86400 * wx.snowHoldFrac;
+        snow.stored += held;
+      }
+      site.live.water = water;
+      site.live.river = { inflow: site.kind==='classic'?0:(wx.Q_river[i]||0), outflow:(water.envReleased+water.S_lower)/actual };
+      totals.P_gen += plant.P_gen; totals.P_pump += plant.P_pump;
+      const deliveredSolar=(site.curtail?.solar||site.managerCurtail) ? 0 : site.arrays.reduce((v,a)=>v+a.P*(1-(a.curtail || 0)),0);
+      const deliveredWind=(site.curtail?.wind||site.managerCurtail) ? 0 : site.windTurbines.reduce((v,w)=>v+w.P*(1-(w.curtail || 0)),0);
+      totals.P_solar += deliveredSolar; totals.P_wind += deliveredWind;
+      site.live.P_solar=deliveredSolar; site.live.P_wind=deliveredWind;
+      totals.finedVolume += water.finedVolume + water.envUnmet;
+      context.plant = plant; context.water = water; context.renewables = renewable;
+      fire('after-plant', context);
+      construction.advanceJobs(site, actual);
+    }
+    fire('after-sites', { state, totals, dt: actual });
+    state.stats.P_net = economy.accumulateStep(state.finance, totals); // §1.2 net across the grid connection.
+    c.tick++; c.secondsIntoHour += actual;
+    if (c.turnRemaining > 0) c.turnRemaining = Math.max(0, c.turnRemaining - actual);
+    if (c.secondsIntoHour >= CONFIG.time.secondsPerHour) {
+      c.secondsIntoHour = 0; c.hour++;
+      const endedDay = c.day;
+      if (c.hour === CONFIG.time.hoursPerDay) { c.hour = 0; c.day++; climate.dayBoundary(state, evap, market.priceDay); }
+      climate.updateHour(state);
+      const hourly = { state, price: price?.price ?? 0, services: 0 };
+      fire('before-settlement', hourly);
+      const settlement = economy.settleHour(state, { price: hourly.price, day: c.day, hour: c.hour, services: hourly.services });
+      if (settlement.bankrupt && !state.finance.sandbox) { c.paused = true; state.finance.gameOver=true; state.alerts.push({type:'bankruptcy',severity:'danger',day:c.day,hour:c.hour}); }
+      state.market.priceNow = currentPrice()?.price ?? 0;
+      fire('hourly', { state, settlement, price: price?.price ?? 0 });
+      if (c.day !== endedDay) {
+        const rain = climate.dayRecord(state, endedDay)?.mean.precipMm ?? 0;
+        for (const site of state.sites) construction.soilingDayAll(site, rain);
+        fire('daily', { state, endedDay, rain });
+      }
+    }
+    protectCash(cashBeforeStep);
+    return actual;
+  }
+  function stepTo(seconds, dt = CONFIG.time.speeds[state.clock.speedIndex].dt) {
+    if (!Number.isFinite(seconds) || seconds < 0 || !Number.isFinite(dt) || dt <= 0) throw new Error('invalid stepTo arguments');
+    let remaining = seconds;
+    while (remaining > 0) remaining -= step(Math.min(dt, remaining));
+  }
+  return { step, stepTo, dispatch, flushActions, stateHash: () => hash(state), getSnapshot: () => copy(state),
+    getClock: () => ({ ...state.clock }), getPendingActions: () => copy(queue),
+    registerActionHandler(type, fn) { if (!knownActions.includes(type) || typeof fn !== 'function') throw new Error('invalid action handler'); handlers.set(type, fn); },
+    registerStepHook(phase, fn) { if (!hooks[phase] || typeof fn !== 'function') throw new Error('invalid hook'); hooks[phase].push(fn); },
+  };
+}
diff --git a/src/sim/environment.js b/src/sim/environment.js
new file mode 100644
index 0000000..61bf84e
--- /dev/null
+++ b/src/sim/environment.js
@@ -0,0 +1,33 @@
+// §9.5 downstream flow, fines and environmental permit.
+import { CONFIG } from '../config.js';
+import { riverBase } from './climate.js';
+
+export function environmentalFlow(site, day, climate = null) {
+  return CONFIG.environment.releaseFraction * riverBase(site, day, climate);
+}
+function envState(state) {
+  return state.stats.environment ??= { cleanDays: 0, finedToday: false, permit: false };
+}
+export function environmentBefore(ctx) {
+  ctx.Q_env = environmentalFlow(ctx.site, ctx.state.clock.day, ctx.state.climate);
+}
+export function environmentAfter({state, water}) {
+  if (water.envUnmet > 0) envState(state).finedToday = true;
+}
+export function environmentDaily({state}) {
+  const e = envState(state);
+  if (e.finedToday) {
+    e.cleanDays = 0;
+    state.services.reliability = Math.max(0, state.services.reliability + CONFIG.reserve.scoreEnvFine);
+  } else e.cleanDays++;
+  e.finedToday = false;
+}
+export function environmentAction(state, action) {
+  if (action.type !== 'BUY_PERMIT') return undefined;
+  const e = envState(state);
+  if (e.permit) return {ok:false, reason:'permit already owned'};
+  if (e.cleanDays < CONFIG.environment.permitCleanDays) return {ok:false, reason:'60 clean days required'};
+  if (state.finance.cash < CONFIG.environment.permitCost) return {ok:false, reason:'insufficient cash'};
+  state.finance.cash -= CONFIG.environment.permitCost; e.permit = true;
+  return {ok:true, cost:CONFIG.environment.permitCost};
+}
diff --git a/src/sim/gameplay.js b/src/sim/gameplay.js
new file mode 100644
index 0000000..2d902e4
--- /dev/null
+++ b/src/sim/gameplay.js
@@ -0,0 +1,47 @@
+// Composes gameplay modules without coupling the kernel to their implementations.
+import { damageBeforeStep, damageAfterSite, damDamageAfterSite, damRepairAction } from './damage.js';
+import { alertsAfterSite, alertsHourly } from './alerts.js';
+import { questAction, questAfterSite, questAfterSites, questHourly, questDaily } from './quests.js';
+import { automationAction, automationBefore } from './automation.js';
+import { siteAction } from './sites.js';
+import { batteryAction, batteryStep } from './battery.js';
+import { initServices, reserveAction, reserveBefore, reserveAfterSites, reserveSettlement, reserveBeginStep } from './services.js';
+import { environmentAction, environmentBefore, environmentAfter, environmentDaily } from './environment.js';
+import { telemetryHourly } from './telemetry.js';
+import { managerPurchase } from './manager.js';
+
+export function installGameplay(engine, state, {restoreManagerPending=true}={}) {
+  if (state) {initServices(state);if(restoreManagerPending&&state.automation.manager?.pending)engine.dispatch(state.automation.manager.pending);}
+  for (const type of ['BUILD', 'SET_FLOW', 'REPAIR']) engine.registerActionHandler(type, (state,action) => {
+    const result=batteryAction(state,action);
+    if(result!==undefined)return result;
+    const damResult=damRepairAction(state,action);
+    return damResult===undefined?automationAction(state,action):damResult;
+  });
+  engine.registerActionHandler('SET_RULES', automationAction);
+  engine.registerActionHandler('BUY_PERMIT', environmentAction);
+  engine.registerActionHandler('CLAIM_QUEST', questAction);
+  engine.registerActionHandler('BUY_SITE', siteAction);
+  engine.registerActionHandler('SET_RESERVE_OFFER', reserveAction);
+  engine.registerStepHook('before-step', ctx=>managerPurchase(ctx,engine.dispatch));
+  engine.registerStepHook('before-step', damageBeforeStep);
+  engine.registerStepHook('before-step', reserveBeginStep);
+  engine.registerStepHook('before-plant', ctx => automationBefore(ctx,engine.dispatch));
+  engine.registerStepHook('before-plant', environmentBefore);
+  engine.registerStepHook('before-plant', reserveBefore);
+  engine.registerStepHook('after-plant', batteryStep);
+  engine.registerStepHook('after-plant', environmentAfter);
+  engine.registerStepHook('after-plant', questAfterSite);
+  engine.registerStepHook('after-plant', alertsAfterSite);
+  engine.registerStepHook('after-plant', damDamageAfterSite);
+  engine.registerStepHook('after-plant', damageAfterSite);
+  engine.registerStepHook('after-sites', reserveAfterSites);
+  engine.registerStepHook('after-sites', questAfterSites);
+  engine.registerStepHook('before-settlement', reserveSettlement);
+  engine.registerStepHook('hourly', questHourly);
+  engine.registerStepHook('hourly', alertsHourly);
+  engine.registerStepHook('hourly', telemetryHourly);
+  engine.registerStepHook('daily', environmentDaily);
+  engine.registerStepHook('daily', questDaily);
+  return engine;
+}
diff --git a/src/sim/investment.js b/src/sim/investment.js
new file mode 100644
index 0000000..7d4c1a6
--- /dev/null
+++ b/src/sim/investment.js
@@ -0,0 +1,33 @@
+// §7.4 forecast-based renewable investment estimate. This is a quote only:
+// it clones plant equipment and never consumes RNG or mutates the live state.
+import { CONFIG } from '../config.js';
+import { solarPrice, windPrice } from './construction.js';
+import { updateSiteRenewables, windRated } from './renewables.js';
+import { npv, omAnnual, rAnnualRenewable } from './economy.js';
+
+export function previewRenewableInvestment(state, siteId, {kind,tier,parcel,tile}) {
+  const site=state.sites.find(s=>s.id===siteId);
+  if(!site || !['solar','wind'].includes(kind) || !Number.isInteger(tier) || !(kind==='solar'?CONFIG.solar.modules[tier]:CONFIG.wind.tiers[tier]))return {ok:false,reason:'Invalid equipment'};
+  if(!site.parcels.some(p=>p.id===parcel&&p.owned))return {ok:false,reason:'Parcel not owned'};
+  if(!Number.isInteger(tile)||tile<0||tile>=CONFIG.parcels.nTiles)return {ok:false,reason:'Invalid tile'};
+  const list=kind==='solar'?site.arrays:site.windTurbines,other=kind==='solar'?site.windTurbines:site.arrays;
+  if(list.some(u=>u.parcel===parcel&&u.tile===tile))return {ok:false,reason:'Tile already occupied by this technology'};
+  const colocated=other.some(u=>u.parcel===parcel&&u.tile===tile);
+  const capex=(kind==='solar'?solarPrice(tier):windPrice(tier))*(colocated?1-CONFIG.parcels.secondTechDiscount:1);
+  const before={arrays:site.arrays.map(a=>({...a})),windTurbines:site.windTurbines.map(w=>({...w}))};
+  const after={arrays:before.arrays.map(a=>({...a})),windTurbines:before.windTurbines.map(w=>({...w}))};
+  const id=Math.max(0,...list.map(u=>u.id))+1;
+  if(kind==='solar')after.arrays.push({id,tier,parcel,tile,modules:CONFIG.solar.modules[tier],f_soil:CONFIG.soiling.max});
+  else after.windTurbines.push({id,tier,parcel,tile});
+  const start=(state.clock.day-1)*24+state.clock.hour,energy=[],prices=[];
+  for(let i=0;i<24;i++){
+    const index=start+i,day=state.climate.days.find(d=>d.day===Math.floor(index/24)+1),wx=day?.hours?.[index%24],market=state.market.prices.find(p=>p.hourIndex===index);
+    if(!wx||!market||!Number.isFinite(market.forecast))return {ok:false,reason:'24-hour forecast unavailable'};
+    const a=updateSiteRenewables(before,wx),b=updateSiteRenewables(after,wx);
+    energy.push((b.P_solar+b.P_wind-a.P_solar-a.P_wind)/CONFIG.energy.wPerMW);prices.push(market.forecast);
+  }
+  const capacity=kind==='solar'?CONFIG.solar.modules[tier]*CONFIG.solar.A_panel*CONFIG.solar.etaPanel[tier]/1000:windRated(CONFIG.wind.tiers[tier].R)/CONFIG.energy.wPerMW;
+  const deltaEnergy=energy.reduce((a,b)=>a+b,0),deltaOM=omAnnual(capacity,deltaEnergy*CONFIG.finance.npv.daysPerYear);
+  const annualRevenue=rAnnualRenewable(energy,prices,deltaOM);
+  return {ok:true,capex,colocated,deltaEnergy,deltaOM,annualRevenue,npv:npv(capex,annualRevenue),day:state.clock.day,hour:state.clock.hour};
+}
