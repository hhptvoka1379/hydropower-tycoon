+    return { ok: true, cost, batteryId: id };
+  }
+  const b = site.batteries.find(x => x.id === action.batteryId);
+  if (!b) return { ok: false, reason: 'no such battery' };
+  if (action.type === 'SET_FLOW') {
+    if (!Number.isFinite(action.targetPct) || action.targetPct < -1 || action.targetPct > 1) return { ok: false, reason: 'invalid battery target' };
+    b.target = action.targetPct; b.manualTarget = action.targetPct;
+    return { ok: true };
+  }
+  if (b.refurbishSeconds > 0) return { ok: false, reason: 'already refurbishing' };
+  const cost = refurbishCost(b.tier);
+  if (state.finance.cash < cost) return { ok: false, reason: 'insufficient cash' };
+  state.finance.cash -= cost; b.refurbishSeconds = CONFIG.battery.refurbishSeconds;
