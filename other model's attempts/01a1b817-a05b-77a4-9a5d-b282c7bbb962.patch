+// Progression and grants (§9.8). Rewards are charged dollars, not base prices.
+import { CONFIG } from '../config.js';
+import { netPower, outstandingPrincipal, solarStcW } from './economy.js';
+import { windRated } from './renewables.js';
+import { ownedEquipmentPrice } from './construction.js';
+
+function tracker(state) {
+  return state.quests.tracker ??= {pumpedVolume:0,genMWh:0,soldEvening:false,profit:0,
+    negativeRevenue:0,pumpedToday:0,generatedToday:0,autumnPumped:[],iceDays:0,
+    efficientDays:0,reliableDays:0,springFlood:false,heatFailed:{}};
+}
+function complete(state,id) {
+  if (state.quests.completed.includes(id)) return;
+  state.quests.completed.push(id);
+  state.alerts.push({type:'quest_complete',questId:id,day:state.clock.day,hour:state.clock.hour});
+}
+export function questAction(state,action) {
+  if (action.type!=='CLAIM_QUEST') return undefined;
+  const id=action.id, q=state.quests;
+  if (!Number.isInteger(id) || !q.completed.includes(id) || q.claimed.includes(id)) return {ok:false,reason:'quest reward unavailable'};
+  const reward=CONFIG.quests.rewards[id];
+  if (reward.cash) state.finance.cash+=reward.cash;
+  if (reward.slots) state.automation.slots=Math.min(CONFIG.rules.maxSlots,(state.automation.slots ?? CONFIG.rules.initialSlots)+reward.slots);
+  if (reward.arch) q.archUnlocked=true;
+  if (reward.sandbox) q.sandbox=true;
+  q.claimed.push(id);
+  return {ok:true,reward};
+}
+export function questAfterSite({state,site,plant,water,dt}) {
+  const t=tracker(state), day=state.clock.day;
+  // Track actual renewable delivery against nameplate capacity-hours for the
+  // first-year score; capacity changes are weighted by their time installed.
+  if(day<=CONFIG.time.daysPerYear) {
+    const score=site.renewableScore ??= {energyMWh:0,capacityMWh:0};
+    const rated=site.arrays.reduce((n,a)=>n+solarStcW(a),0)+site.windTurbines.reduce((n,w)=>n+windRated(CONFIG.wind.tiers[w.tier].R),0);
+    const factor=dt/CONFIG.time.secondsPerHour/CONFIG.energy.wPerMW;
+    score.capacityMWh+=rated*factor;score.energyMWh+=((site.live?.P_solar||0)+(site.live?.P_wind||0))*factor;
+  }
+  if (plant.Q_up>0) t.pumpedVolume+=plant.Q_up*dt;
+  if (day>=92 && day<=100 && water.S_lower>0) t.springFlood=true;
