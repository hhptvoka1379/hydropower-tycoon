+++ b/src/sim/manager.js
@@ -0,0 +1,72 @@
+// Optional forecast-based manager. User rules take precedence; this is a
+// conservative heuristic, not a guarantee of globally optimal profit.
+import { CONFIG } from '../config.js';
+import { previewRenewableInvestment } from './investment.js';
+import { turbinePrice, pumpPrice, penstockPrice, cleanCost, arrayStcKW } from './construction.js';
+import { eCycle, meanExtreme, npv, omAnnual, rAnnualStorage } from './economy.js';
+import { storedEnergyMWh } from './reservoirs.js';
+import { damRepairCost } from './damage.js';
+import { repairCost } from './wear.js';
+import { batteryCost, refurbishCost } from './battery.js';
+import { solvePlant } from './plant.js';
+
+export function estimatePenstockUpgrade(site,D,prices){
+  if(!CONFIG.penstock.diameters.includes(D)||D<=site.penstock.D||prices.length<24)return null;
+  function scenario(diameter){
+    const solve=mode=>{const copy=JSON.parse(JSON.stringify(site));copy.penstock.D=diameter;for(const u of [...copy.turbines,...copy.pumps]){u.Q=0;u.targetPct=(mode==='gen'&&u.kind==='turbine')||(mode==='pump'&&u.kind==='pump')?0.9:0;}return solvePlant(copy,60);};
+    const gen=solve('gen'),pump=solve('pump');if(!(gen.Q_pen>0&&pump.Q_pen>0&&pump.P_pump>0))return null;
+    const rte=Math.max(0.01,Math.min(1,(gen.P_gen/gen.Q_pen)/(pump.P_pump/pump.Q_pen)));
