+
+// Pump curve (§2.5), then × η_mult.
+function pumpEfficiency(etaRated, Q, Q_des, etaMult = 1) {
+  const xq = Q_des > 0 ? (Q / Q_des - 1) / HY.pumpHillQWidth : 0;
