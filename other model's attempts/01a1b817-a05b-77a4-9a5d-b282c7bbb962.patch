+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+import { performance } from 'node:perf_hooks';
+import assert from 'node:assert/strict';
+const html=readFileSync('hydropower-tycoon.html','utf8');
+const scripts=[...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].map(x=>x[1]);
+assert.equal(scripts.length,2);
+assert.ok(!/<(?:script|link)[^>]+(?:src|href)=/i.test(html));
+const context={console,performance,requestAnimationFrame:()=>1,cancelAnimationFrame:()=>{}};
+runInNewContext(scripts[0],context,{timeout:10000});
+runInNewContext(scripts[1],context,{timeout:10000});
+assert.equal(typeof context.THREE.WebGLRenderer,'function');
+assert.equal(typeof context.Game.dispatch,'function');
+const before=context.Game.engine.getClock().tick;
+context.Game.dispatch({type:'SET_FLOW',unitId:1,targetPct:0.5});
+context.Game.engine.step(1);
+assert.equal(context.Game.engine.getClock().tick,before+1);
+assert.ok(context.Game.engine.getSnapshot().sites[0].turbines[0].Q>0);
+console.log(`offline bundle smoke: ${scripts.length} inline scripts, THREE present, game step ${before}→${before+1} PASS`);
