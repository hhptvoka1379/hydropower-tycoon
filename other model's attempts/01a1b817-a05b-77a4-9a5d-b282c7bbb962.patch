+// §9.4 reserve capacity and call accounting, units MW, MWh, hours, dollars.
+import { CONFIG } from '../config.js';
+import { nextFloat } from '../rng.js';
+import { netPower } from './economy.js';
+import { solvePlant } from './plant.js';
+import { updateSiteRenewables } from './renewables.js';
+import { stepBattery } from './battery.js';
+
+export function reserveRequirement(R) { return CONFIG.reserve.reqBase + CONFIG.reserve.reqSlope * Math.max(0, R); }
+export function capacityPrice(R, score) {
+  const r=CONFIG.reserve;
+  return (r.priceBase + r.priceSlope * Math.max(0,R)) * (score >= r.scoreBonusThreshold ? r.scorePriceMultiplier : 1);
+}
+export function clampOffer(offer, requirement) { return Math.max(0,Math.min(offer,requirement)); }
+export function capacityPayment(offer, R, score) { return clampOffer(offer,reserveRequirement(R))*capacityPrice(R,score); }
+export function callPayment(deliveredMWh, price) { return Math.max(price,CONFIG.reserve.minCallPrice)*Math.max(0,deliveredMWh); }
+export function scoreAfter(score, event) {
+  const r=CONFIG.reserve;
+  const delta={callSuccess:r.scoreCallSuccess,callFailure:r.scoreCallFailure,
+    emergencySuccess:r.scoreEmergencySuccess,emergencyFailure:r.scoreEmergencyFailure,environmentFine:r.scoreEnvFine}[event];
+  if (delta === undefined) throw new Error('unknown reliability event');
+  return Math.max(0,Math.min(100,score+delta));
+}
+export function callSucceeded(deliveredMW, offerMW) { return deliveredMW >= CONFIG.reserve.deliveryFraction * offerMW; }
+export function failedCapacityAdjustment(payment) { return -(1+CONFIG.reserve.failureFineMultiple)*payment; }
+
+export function initServices(state) {
+  const s=state.services;
+  if (!s.initialized) {
