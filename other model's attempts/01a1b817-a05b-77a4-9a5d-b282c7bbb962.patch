+// Browser entry: UI and world communicate only through the Game API.
+import { Game } from './game.js';
+import { initUI } from './ui/app.js';
+import { runSelfTest, hashState } from './selftest.js';
+
+if (typeof document !== 'undefined') {
+  const root=document.createElement('main');document.body.append(root);
+  initUI(root,Game);
+  // A separate worker keeps the thorough audit from blocking the interface.
+  const source=document.currentScript?.textContent;
+  globalThis.__HYDRO_AUDIT__={status:'pending',allPassed:false,getSnapshot:()=>Game.getSnapshot()};
+  if (source && typeof Worker==='function') {
+    try {
+      const url=URL.createObjectURL(new Blob([source],{type:'text/javascript'}));
+      const worker=new Worker(url);
+      worker.onmessage=e=>{ globalThis.__HYDRO_AUDIT__={...e.data,status:'complete',stateHash:hashState(Game.getSnapshot()),getSnapshot:()=>Game.getSnapshot()}; URL.revokeObjectURL(url);worker.terminate(); };
+      worker.onerror=e=>{globalThis.__HYDRO_AUDIT__={status:'failed',allPassed:false,error:'Background audit failed: '+(e.message||'worker error'),getSnapshot:()=>Game.getSnapshot()};URL.revokeObjectURL(url);worker.terminate();};
+    } catch (e) { globalThis.__HYDRO_AUDIT__={status:'unavailable',allPassed:false,error:'Background self-test unavailable: '+e.message,getSnapshot:()=>Game.getSnapshot()};console.warn('Background self-test unavailable:',e.message); }
+  } else globalThis.__HYDRO_AUDIT__={status:'unavailable',allPassed:false,error:'Background audit requires a browser Worker',getSnapshot:()=>Game.getSnapshot()};
+} else if (typeof self !== 'undefined' && typeof self.postMessage==='function') {
+  const audit=runSelfTest();
+  audit.perf.stepMsAvg=audit.testResults.find(x=>x.id===25)?.actual?.[0] ?? null;
+  self.postMessage({allPassed:audit.allPassed,testResults:audit.testResults,robustnessSweep:audit.robustnessSweep,stateHash:audit.stateHash,perf:audit.perf});
+}
