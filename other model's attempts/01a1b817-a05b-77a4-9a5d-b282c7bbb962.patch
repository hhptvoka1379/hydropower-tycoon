+    E: rec.E, ice: rec.ice, sunrise: rec.sunrise, sunset: rec.sunset,
+    Q_river, Q_melt: qMelt(D, h), snowHoldFrac: holdFrac, stormRunoffMult: sRain ? EV().stormRain.runoffMult : 1,
+  };
+  return state;
+}
+
+Object.assign(exports,{"dayOfYear":dayOfYear,"seasonIndex":seasonIndex,"sunTimes":sunTimes,"dayFactor":dayFactor,"eventsOn":eventsOn,"generateDay":generateDay,"initClimate":initClimate,"dayBoundary":dayBoundary,"dayRecord":dayRecord,"qMelt":qMelt,"riverBase":riverBase,"riverRain":riverRain,"bladeDamaged":bladeDamaged,"updateHour":updateHour,"hourIndex":hourIndex});
+},
+"src/sim/market.js":function(exports,__require){
+// §6 Dynamic grid pricing (duck curve), forecast and market impact. Pure; no DOM.
+const {CONFIG}=__require("src/config.js");
+const {nextRange}=__require("src/rng.js");
+const M = () => CONFIG.market;
+const clampPrice = p => Math.min(M().priceMax, Math.max(M().priceMin, p));
+
+// §6.1 P_base(h) = 45 + 30e^{−(h−8.5)²/2} + 45e^{−(h−19.5)²/2} − DIP(h)
+function pBase(h) {
+  const m = M();
+  const x = Number.isFinite(h) ? h : 0;
+  // DIP(h) = 18 sin²(π(h−10)/6) for 10 ≤ h ≤ 16
+  const dip = (x >= m.dip.start && x <= m.dip.end) ? m.dip.A * Math.sin(Math.PI * (x - m.dip.start) / m.dip.period) ** 2 : 0;
+  const a = Math.max(-700, -((x - m.am.h) ** 2) / 2), b = Math.max(-700, -((x - m.pm.h) ** 2) / 2);
+  return m.base + m.am.A * Math.exp(a) + m.pm.A * Math.exp(b) - dip;
+}
+
+// §6.1 temperature factors: m_T = 1 + 0.025C + 0.020H, f_D = 1 + 0.010C + 0.008H
+function tempFactors(T) {
+  const m = M();
+  const C = Math.max(0, T - m.coolBase), H = Math.max(0, m.heatBase - T);
+  return { C, H, mT: 1 + m.mT_cool * C + m.mT_heat * H, fD: 1 + m.fD_cool * C + m.fD_heat * H };
+}
+
+// §6.2 R_reg = 250·G/1000 + 300·min(1,(u₂/12)³)  [MW]
+function rReg(G, u2) {
+  const m = M();
+  return m.R_solarMW * Math.max(0, G) / 1000 + m.R_windMW * Math.min(1, (Math.max(0, u2) / m.R_windRef) ** 3);
+}
+
+// §6.2 noise-free merit-order price: P_base·m_T·(1 − k·R_reg/(D·f_D)). Takes Pb explicitly so audit can pass any P_base.
+function meritPrice(Pb, T, R) {
+  const m = M();
+  const { mT, fD } = tempFactors(T);
+  const denom = Math.max(1e-9, m.D_total * fD);
+  return Pb * mT * (1 - m.k_merit * R / denom);
+}
+
+// §6.5 λ(h) = P_base·m_T·k_merit/(D_total·f_D)  [$/MWh per MW]
+function lambdaImpact(Pb, T) {
+  const m = M();
+  const { mT, fD } = tempFactors(T);
+  return Pb * mT * m.k_merit / Math.max(1e-9, m.D_total * fD);
+}
+
+// §6.5 Price_eff = Price₀ − λ·P_net  (P_net MW, + export)
+function effectivePrice(price0, lambda, P_netMW) { return price0 - lambda * P_netMW; }
+
+// §6.5 Impact cost of one step: λ·P_net²·dt/3600  [$]; 1 MW × 1 h = 1 MWh
+function impactCost(lambda, P_netMW, dt) { return lambda * P_netMW * P_netMW * dt / 3600; }
+
+// §6.2/§6.3 price one hour from its weather. Draw order (market stream): ε then forecast error e.
+// Returns the record stored in state.market.prices.
+function priceHour(rng, hourIndex, w) {
+  const m = M();
+  const h = ((hourIndex % 24) + 24) % 24;
+  const Pb = pBase(h);
+  const R = rReg(w.G, w.u2);
+  const clean = meritPrice(Pb, w.T, R);
+  const eps = nextRange(rng, 'market', -m.noise, m.noise);
+  const e = nextRange(rng, 'market', -m.forecastErr, m.forecastErr);
+  const unclamped = clean + eps;
+  return {
+    hourIndex, Pb, R_reg: R, clean, eps, unclamped,
+    price: clampPrice(unclamped),                       // Price₀, clamped (§6.2)
+    forecast: clampPrice(clean * (1 + e)),              // §6.3 fixed per target hour
+    lambda: lambdaImpact(Pb, w.T),                      // §6.5
+  };
+}
+
+// §6.4 pure reads. hourIndex = (day−1)·24 + hour.
+function find(state, hourIndex) {
+  const arr = state.market.prices;
+  for (let i = arr.length - 1; i >= 0; i--) if (arr[i].hourIndex === hourIndex) return arr[i];
+  return null;
+}
+function priceAt(state, hourIndex) { const r = find(state, hourIndex); return r ? r.price : null; }
+function forecastAt(state, hourIndex) { const r = find(state, hourIndex); return r ? r.forecast : null; }
+function auditHour(state, hourIndex) {
+  const r = find(state, hourIndex);
+  return r ? { P_base: r.Pb, R_reg: r.R_reg, unclamped: r.unclamped, price: r.price } : null;
+}
+
+// §6 price all 24 hours of a freshly generated climate day (call right after climate.generateDay).
+// Keeps the last 96 hours so saves stay small.
+function priceDay(state, dayRec) {
+  const out = state.market.prices;
+  for (let h = 0; h < 24; h++) {
+    const x = dayRec.hours[h];
+    out.push(priceHour(state.rng, (dayRec.day - 1) * 24 + h, { G: x.G, u2: x.u2, T: x.T }));
+  }
+  while (out.length > 96) out.shift();
+}
+
+Object.assign(exports,{"pBase":pBase,"tempFactors":tempFactors,"rReg":rReg,"meritPrice":meritPrice,"lambdaImpact":lambdaImpact,"effectivePrice":effectivePrice,"impactCost":impactCost,"priceHour":priceHour,"priceAt":priceAt,"forecastAt":forecastAt,"auditHour":auditHour,"priceDay":priceDay,"clampPrice":clampPrice});
+},
+"src/sim/renewables.js":function(exports,__require){
+// §5.3 wind, §5.4 solar, §5.5 parcels/shading. Pure; no DOM.
+const {CONFIG}=__require("src/config.js");
+const W = () => CONFIG.wind, S = () => CONFIG.solar, PC = () => CONFIG.parcels;
+
+// §5.3 hub speed: v_hub = u₂·(H_hub/2)^0.143 (1/7 power-law shear)
+function hubSpeed(u2, H_hub) {
+  const w = W();
+  return Math.max(0, u2) * Math.pow(Math.max(1e-9, H_hub / w.refHeight), w.shearExp);
+}
+
+// §5.3 cubic P = ½ρ_air·A·v³·Cp·η_mech  [W]
+function cubic(v, R) {
+  const w = W();
+  return 0.5 * CONFIG.physics.rhoAir * Math.PI * R * R * v * v * v * w.Cp * w.etaMech;
+}
+
+// §5.3 rated power, the cubic evaluated at 12 m/s  [W]
+function windRated(R) { return cubic(W().rated, R); }
+
+// §5.3 four-region power curve, given hub speed v (m/s) and rotor radius R (m)  [W]
+function windPower(v, R) {
+  const w = W();
+  if (!(v >= w.cutIn) || v > w.cutOut) return 0;   // cut-in / cut-out
+  if (v >= w.rated) return windRated(R);           // rated plateau, no cubic runaway
+  return cubic(v, R);
+}
+
+// §5.3 Jensen wake with direction averaging. Tuned game simplification, not a derivation.
+// η_wake = max(0.65, 1 − (N−1)·φ·δ_J), δ_J = (1 − √(1−C_T))/(1 + 2k_w·S_norm)², S_norm = 150/(2R), mean over turbines
+function wakeFactor(tiers) {
+  const w = W();
+  const n = tiers.length;
+  if (n <= 1) return 1;
+  let sNorm = 0;
+  for (const t of tiers) sNorm += w.tilePitch / (2 * w.tiers[t].R);
+  sNorm /= n;
+  const dJ = (1 - Math.sqrt(Math.max(0, 1 - w.C_T))) / ((1 + 2 * w.k_w * sNorm) ** 2);
+  return Math.max(w.etaWakeMin, 1 - (n - 1) * w.phi * dJ);
+}
+
+// §5.3 parcel output: η_wake × Σ P_wind,i. turbines: [{tier, offline?}], u2 m/s. Returns {total, each[]} in W.
+function parcelWind(turbines, u2) {
+  const w = W();
+  const eta = wakeFactor(turbines.map(t => t.tier));
+  const each = turbines.map(t => {
+    if (t.offline) return 0;
+    const spec = w.tiers[t.tier];
+    return eta * windPower(hubSpeed(u2, spec.H_hub), spec.R);
+  });
+  return { eta, each, total: each.reduce((a, b) => a + b, 0) };
+}
+
+// §5.4 solar PV. Explicit inputs for the pure test. Returns {G_eff, P_dc, T_cell, tempFactor, P_ac} (W, °C).
+function solarPower({ G, area, eta, T, shade = 0, fSoil = 1 }) {
+  const s = S();
+  const G_eff = Math.max(0, G) * (1 - shade);                    // G_eff = G(1 − shade)
+  const P_dc = area * G_eff * eta;                               // P_dc = N·A·G_eff·η (area = N·A_panel)
+  const T_cell = T + G_eff / s.G_noct * s.dT_noct;               // T_cell = T + G_eff/800·25
+  const tempFactor = Math.max(0, 1 - s.gamma * (T_cell - s.T_ref)); // bracket clamped at 0
+  const P_ac = P_dc * tempFactor * s.etaInv * fSoil;             // P_ac = P_dc(1−γ(T_cell−25))η_inv·f_soil
+  return { G_eff, P_dc, T_cell, tempFactor, P_ac };
+}
+
+// §5.4 an array of a tier: area = modules × 1.7 m²
+function arrayPower(arr, G, T, shade) {
+  const s = S();
+  return solarPower({ G, area: arr.modules * s.A_panel, eta: s.etaPanel[arr.tier], T, shade, fSoil: arr.f_soil ?? 1 }).P_ac;
+}
+
+// §5.5 shade = k_shade·N_wind/N_tiles + k_coloc·[tile also holds wind]
+function solarShade(nWind, colocated) {
+  const p = PC();
+  return p.k_shade * nWind / p.nTiles + (colocated ? p.k_coloc : 0);
+}
+
+// §5.5 recompute layout factors for a site (on layout change and hourly, never per step).
+// Wind turbines and arrays carry .parcel and optional .tile. Returns {wakeByParcel, shadeByArray}.
+function layoutFactors(site) {
+  const wakeByParcel = {}, shadeByArray = {};
+  const wt = site.windTurbines || [];
+  const parcels = new Set(wt.map(t => t.parcel ?? 1));
+  for (const p of parcels) wakeByParcel[p] = wakeFactor(wt.filter(t => (t.parcel ?? 1) === p).map(t => t.tier));
+  for (const a of site.arrays || []) {
+    const onParcel = wt.filter(t => (t.parcel ?? 1) === (a.parcel ?? 1));
+    const coloc = a.tile != null && onParcel.some(t => t.tile === a.tile);
+    shadeByArray[a.id] = solarShade(onParcel.length, coloc);
+  }
+  return { wakeByParcel, shadeByArray };
+}
+
+// §5.6 site renewables for the current hour weather {G, T, u2}. Writes P (W) on each unit; returns totals.
+function updateSiteRenewables(site, wx) {
+  const { shadeByArray } = layoutFactors(site);
+  let P_solar = 0, P_wind = 0;
+  for (const a of site.arrays || []) { a.P = arrayPower(a, wx.G, wx.T, shadeByArray[a.id]); P_solar += a.P; }
+  const wt = site.windTurbines || [];
+  const byParcel = {};
+  for (const t of wt) (byParcel[t.parcel ?? 1] ||= []).push(t);
+  for (const list of Object.values(byParcel)) {
+    const r = parcelWind(list, wx.u2);
+    list.forEach((t, i) => { t.P = r.each[i]; });
+    P_wind += r.total;
+  }
+  return { P_solar, P_wind };
+}
+
+Object.assign(exports,{"hubSpeed":hubSpeed,"windRated":windRated,"windPower":windPower,"wakeFactor":wakeFactor,"parcelWind":parcelWind,"solarPower":solarPower,"arrayPower":arrayPower,"solarShade":solarShade,"layoutFactors":layoutFactors,"updateSiteRenewables":updateSiteRenewables});
+},
+"src/sim/construction.js":function(exports,__require){
+// §8 Construction and equipment (Classic site): price list × CAPEX_SCALE, Classic dam raise, excavation stages,
+// solar soiling and cleaning, repair jobs, job timers. Pure; no DOM. Money in $, volumes m³, time in game days/seconds.
+// Job schema in site.jobs: {type:'raise'|'excavate'|'clean'|'repair', secondsLeft, ...}. Repair jobs are {type:'repair', unitId} (Physics hand-off).
+const {CONFIG}=__require("src/config.js");
+const {frustumVolume, frustumDepth}=__require("src/state.js");
+const {repairCost, repairHours}=__require("src/sim/wear.js");
+const {finishProceduralRaise}=__require("src/sim/canyon.js");
+const SCALE = () => CONFIG.CAPEX_SCALE;
+const DAY = 86400;   // s per game day
+
+// ---------------------------------------------------------------- §8.1 prices: charged = base × CAPEX_SCALE
+function charged(base) { return base * SCALE(); }
+const pumpPrice = tier => charged(CONFIG.pumps[tier].basePrice);
+const turbinePrice = tier => charged(CONFIG.turbines[tier].basePrice);
+const windPrice = tier => charged(CONFIG.windBasePrice[tier]);
+const solarPrice = tier => charged(CONFIG.solarBasePrice[tier]);
+const parcelPrice = n => charged(CONFIG.landParcelBasePrice[n]);
+// Penstock: per-metre price by diameter, concrete −15% cost (§8.1). Replacing charges the full new price, no refund.
+function penstockPrice(D, L, material = 'steel') {
+  const i = CONFIG.penstock.diameters.indexOf(D);
+  if (i < 0) throw new Error('unknown penstock diameter ' + D);
+  const f = material === 'concrete' ? CONFIG.penstock.concreteCostFactor : 1;
+  return charged(CONFIG.penstock.basePricePerM[i] * L * f);
+}
+// Purchase price of the equipment the player owns (credit limit §7.3): machines, arrays, wind turbines and penstocks.
+function ownedEquipmentPrice(state) {
+  let p = 0;
+  for (const s of state.sites) {
+    for (const u of s.turbines) p += turbinePrice(u.tier);
+    for (const u of s.pumps) p += pumpPrice(u.tier);
+    for (const w of s.windTurbines) p += w.purchasePrice ?? windPrice(w.tier);
+    for (const a of s.arrays) p += a.purchasePrice ?? solarPrice(a.tier);
+    for (const b of s.batteries || []) p += charged(CONFIG.battery.tiers[b.tier].basePrice); // §9.3 equipment credit
+    p += penstockPrice(s.penstock.D, s.penstock.L, s.penstock.material);
+  }
+  return p;
+}
+
+// ---------------------------------------------------------------- §8.2 Classic dam raise
+// Cost_raise = C_dam·(H_new² − H_old²) with C_dam charged = 800 × CAPEX_SCALE = $32/m²; Days = 2 + ΔH/5
+function classicRaiseCost(Hold, Hnew) { return charged(CONFIG.dam.C_dam) * (Hnew * Hnew - Hold * Hold); }
+function classicRaiseDays(Hold, Hnew) { return CONFIG.dam.raiseDaysBase + (Hnew - Hold) * CONFIG.dam.raiseDaysPerM; }
+// Plan a raise of the Classic site to gross head Hnew: cost, days, ΔV_max of the upper reservoir (D_max grows by ΔH).
+function classicRaisePlan(site, Hnew) {
+  const up = site.reservoirs.upper, Hold = site.dam.H_gross;
+  const limit = CONFIG.dam.classMaxGrossHead[site.dam.class];
+  if (!(Hnew > Hold)) return { ok: false, reason: 'new head must exceed the current head' };
+  if (Hnew > limit) return { ok: false, reason: 'exceeds the ' + site.dam.class + ' class limit of ' + limit + ' m' };
+  const dH = Hnew - Hold;
+  const Vmax1 = frustumVolume(up.A_bot, up.s, up.D_max + dH);
+  return { ok: true, Hold, Hnew, dH, cost: classicRaiseCost(Hold, Hnew), days: classicRaiseDays(Hold, Hnew), VmaxNew: Vmax1, dVmax: Vmax1 - up.V_max };
+}
+// Start the raise: cash is charged by the caller (engine validates budget); the reservoir keeps working during the build.
+function startClassicRaise(site, Hnew) {
+  const plan = classicRaisePlan(site, Hnew);
+  if (!plan.ok) return plan;
+  if (site.dam.building) return { ok: false, reason: 'dam already under construction' };
+  const job = { type: 'raise', fromH: plan.Hold, toH: Hnew, dH: plan.dH, cost: plan.cost, secondsLeft: plan.days * DAY };
+  site.jobs.push(job);
+  site.dam.building = { toH: Hnew };
+  return { ok: true, job, plan };
+}
+function finishClassicRaise(site, job) {
+  const up = site.reservoirs.upper;
+  up.D_max += job.dH;                                          // A raise increases D_max by ΔH (§8.2)
+  up.V_max = frustumVolume(up.A_bot, up.s, up.D_max);
+  up.d = frustumDepth(up.A_bot, up.s, up.D_max, up.V);
+  up.z = up.z_floor + up.d;
+  site.dam.H_gross = job.toH;
+  site.dam.building = null;
+}
+
+// ---------------------------------------------------------------- §8.5 excavation (lower reservoir, and upper at Classic site)
+// Stage adds 5,000 m² to A_bot; ΔV_max exact; Cost = 0.12·ΔV + 800 (charged); Days = max(2, ceil(ΔV/50,000)). Slope unchanged.
+function excavationPlan(res) {
+  const ex = CONFIG.excavation;
+  if (res.table) return { ok: false, reason: 'tabulated reservoirs cannot be excavated' };
+  if ((res.excavationStages || 0) >= ex.stages) return { ok: false, reason: 'all ' + ex.stages + ' stages done' };
+  const A1 = res.A_bot + ex.stageAddAbot;
+  const dV = frustumVolume(A1, res.s, res.D_max) - frustumVolume(res.A_bot, res.s, res.D_max);
+  return {
+    ok: true, dVmax: dV, A_bot: A1,
+    cost: charged(ex.basePricePerM3) * dV + charged(ex.baseMobilization),
+    days: Math.max(ex.minDays, Math.ceil(dV / ex.m3PerDay)),
+  };
+}
+function startExcavation(site, which) {
+  const res = site.reservoirs[which];
+  if (!res) return { ok: false, reason: 'no such reservoir' };
+  if (site.jobs.some(j => j.type === 'excavate' && j.which === which)) return { ok: false, reason: 'excavation already under way' };
+  const plan = excavationPlan(res);
+  if (!plan.ok) return plan;
+  const job = { type: 'excavate', which, cost: plan.cost, dVmax: plan.dVmax, secondsLeft: plan.days * DAY };
+  site.jobs.push(job);
+  return { ok: true, job, plan };
+}
+function finishExcavation(site, job) {
+  const r = site.reservoirs[job.which];
+  r.A_bot += CONFIG.excavation.stageAddAbot;
+  r.V_max = frustumVolume(r.A_bot, r.s, r.D_max);
+  r.d = frustumDepth(r.A_bot, r.s, r.D_max, r.V);
+  r.z = r.z_floor + r.d;
+  r.excavationStages = (r.excavationStages || 0) + 1;
+}
+
+// ---------------------------------------------------------------- §8.6 soiling and cleaning
+// Daily update: a rain day (≥ 5 mm) raises f_soil by 0.02 up to the 0.95 cap (a value already above the cap stays);
+// a dry day loses 0.0006; f_soil never drops below 0.55 (§8.6, Test 16).
+function soilingDay(f, rainMm) {
+  const S = CONFIG.soiling;
+  if (rainMm >= S.rainThresholdMm) return Math.min(S.max, Math.max(f, Math.min(f + S.rainGain, S.rainCap)));
+  return Math.max(S.min, f - S.dailyLoss);
+}
+function soilingDayAll(site, rainMm) { for (const a of site.arrays) a.f_soil = soilingDay(a.f_soil, rainMm); }
+// A cleaning job adds 0.15 to f_soil up to 1.00
+function cleaned(f) { return Math.min(CONFIG.soiling.max, f + CONFIG.soiling.cleanGain); }
+// Price: $0.80 per kW of STC power, NOT CAPEX_SCALE-scaled (Test 16: 0.80·535 = $428; §8.6 states the charged price directly)
+function cleanCost(P_stc_kW) { return CONFIG.soiling.cleanCostPerKW * P_stc_kW; }
+function arrayStcKW(arr) { return arr.modules * CONFIG.solar.A_panel * CONFIG.solar.etaPanel[arr.tier]; }   // 1000 W/m² STC → kW
+function startCleaning(site, arrayId) {
+  const arr = site.arrays.find(a => a.id === arrayId);
+  if (!arr) return { ok: false, reason: 'no such array' };
+  if (arr.cleaning) return { ok: false, reason: 'already being cleaned' };
+  const cost = cleanCost(arrayStcKW(arr));
+  const job = { type: 'clean', arrayId, cost, secondsLeft: CONFIG.soiling.cleanDays * DAY };
+  site.jobs.push(job);
+  arr.cleaning = true;   // the array keeps producing during the job
+  return { ok: true, job, cost };
+}
+
+// ---------------------------------------------------------------- §4.4 repair jobs (shape fixed by Physics: {type:'repair', unitId})
+function startRepair(site, unit) {
+  const health = 100 * (1 - unit.wear);
+  const base = unit.kind === 'pump' ? CONFIG.pumps[unit.tier].basePrice : CONFIG.turbines[unit.tier].basePrice;
+  const cost = repairCost(health, charged(base));
+  if (site.jobs.some(j => j.type === 'repair' && j.unitId === unit.id)) return { ok: false, reason: 'repair already under way' };
+  const job = { type: 'repair', unitId: unit.id, cost, secondsLeft: repairHours(health) * 3600 };
+  site.jobs.push(job);
+  return { ok: true, job, cost };
+}
+
+// ---------------------------------------------------------------- job timers
+// Advance every job by dt seconds; apply the effect of finished raise, excavation, cleaning and repair jobs and return them.
+// Procedural raises are jobs of type 'raise' with procedural:true, finished by canyon.finishProceduralRaise.
+function advanceJobs(site, dt) {
+  const done = [];
+  for (let i = site.jobs.length - 1; i >= 0; i--) {
+    const j = site.jobs[i];
+    j.secondsLeft -= dt;
+    if (j.secondsLeft > 1e-9) continue;
+    site.jobs.splice(i, 1);
+    if (j.type === 'raise') {
+      if (j.procedural) finishProceduralRaise(site, j); else finishClassicRaise(site, j);
+    } else if (j.type === 'excavate') finishExcavation(site, j);
+    else if (j.type === 'clean') {
+      const a = site.arrays.find(x => x.id === j.arrayId);
+      if (a) { a.f_soil = cleaned(a.f_soil); a.cleaning = null; }
+    } else if (j.type === 'repair') {
+      const u = [...site.turbines, ...site.pumps].find(x => x.id === j.unitId);
+      if (u) u.wear = 0;
+    }
+    done.push(j);
+  }
+  return done.reverse();
+}
+
+Object.assign(exports,{"charged":charged,"penstockPrice":penstockPrice,"ownedEquipmentPrice":ownedEquipmentPrice,"classicRaiseCost":classicRaiseCost,"classicRaiseDays":classicRaiseDays,"classicRaisePlan":classicRaisePlan,"startClassicRaise":startClassicRaise,"excavationPlan":excavationPlan,"startExcavation":startExcavation,"soilingDay":soilingDay,"soilingDayAll":soilingDayAll,"cleaned":cleaned,"cleanCost":cleanCost,"arrayStcKW":arrayStcKW,"startCleaning":startCleaning,"startRepair":startRepair,"advanceJobs":advanceJobs,"pumpPrice":pumpPrice,"turbinePrice":turbinePrice,"windPrice":windPrice,"solarPrice":solarPrice,"parcelPrice":parcelPrice});
+},
+"src/sim/economy.js":function(exports,__require){
+// §7 Financial system: per-step netting, hourly settlement, O&M, loans, emergency loan, NPV, LCOS, RTE, firm contract.
+// Pure functions over state.finance; no DOM. Money in $, energy in MWh (1 MW × 1 h = 1 MWh), power in W unless named MW.
+// Engine API per step:   accumulateStep(state.finance, {P_gen,P_wind,P_solar,P_pump,P_bat_dis,P_bat_ch,lambda,dt,finedVolume})
+// Engine API per hour:   settleHour(state, {price, day, hour, services})  (day/hour = the clock AFTER the boundary was crossed)
+// state.finance.hourly carries extra nested accumulators: impact ($), E_thru (MWh), fines ($), reported to the orchestrator.
+const {CONFIG}=__require("src/config.js");
+const {impactCost}=__require("src/sim/market.js");
+const {windRated}=__require("src/sim/renewables.js");
+const {ownedEquipmentPrice}=__require("src/sim/construction.js");
+const F = () => CONFIG.finance;
+const finite = x => (Number.isFinite(x) ? x : 0);
+
+// ---------------------------------------------------------------- §1.2 / §7.1 per-step netting
+// P_net = P_gen + P_wind + P_solar (+ P_bat,dis) − P_pump (− P_bat,ch)  [W]
+function netPower(p) {
+  return finite(p.P_gen) + finite(p.P_wind) + finite(p.P_solar) + finite(p.P_bat_dis) - finite(p.P_pump) - finite(p.P_bat_ch);
+}
+
+// One step of netting: E_sold += max(P_net,0)/1e6·dt/3600, E_bought += max(−P_net,0)/1e6·dt/3600 (MWh).
+// Also adds the §6.5 impact λ·P_net²·dt/3600, the throughput for §7.2 O&M, fines (§3/§9.5 $/m³) and the gross lifetime counters (§1.2).
+function accumulateStep(fin, p) {
+  const dt = p.dt;
+  const Pnet = netPower(p);
+  const PnetMW = Pnet / CONFIG.energy.wPerMW;
+  const k = dt / CONFIG.energy.secPerHour;     // h
+  const h = fin.hourly;
+  h.E_sold += Math.max(PnetMW, 0) * k;
+  h.E_bought += Math.max(-PnetMW, 0) * k;
+  h.impact = finite(h.impact) + impactCost(finite(p.lambda), PnetMW, dt);
+  // E_thru = pumped + turbined + produced by wind and solar (§7.2) plus battery throughput
+  h.E_thru = finite(h.E_thru) + (finite(p.P_gen) + finite(p.P_wind) + finite(p.P_solar) + finite(p.P_pump) + finite(p.P_bat_dis) + finite(p.P_bat_ch)) / CONFIG.energy.wPerMW * k;
+  h.fines = finite(h.fines) + F().finePerM3 * Math.max(0, finite(p.finedVolume));
+  fin.lifetime.E_gen += finite(p.P_gen) / CONFIG.energy.wPerMW * k;   // gross turbine energy, MWh (§1.2)
+  fin.lifetime.E_pump += finite(p.P_pump) / CONFIG.energy.wPerMW * k; // gross pump energy, MWh (§1.2)
+  return Pnet;
+}
+
+// ---------------------------------------------------------------- §7.2 O&M
+// O&M_hour = 0.15·C_MW + 0.10·E_thru
+function omHour(C_MW, E_thru) {
+  return F().om.perMWHour * C_MW + F().om.perMWhThru * E_thru;
+}
+
+// Installed capacity C_MW: turbines + pumps + wind + solar (STC) + batteries, rated MW (§7.2)
+function solarStcW(arr) { return arr.modules * CONFIG.solar.A_panel * CONFIG.solar.etaPanel[arr.tier] * 1000; } // 1000 W/m² STC (§5.4, §8.6)
+function installedMW(site) {
+  let W = 0;
+  for (const u of site.turbines) W += CONFIG.turbines[u.tier].P_rated;
+  for (const u of site.pumps) W += CONFIG.pumps[u.tier].P_rated;
+  for (const w of site.windTurbines) W += windRated(CONFIG.wind.tiers[w.tier].R);
+  for (const a of site.arrays) W += solarStcW(a);
+  for (const b of site.batteries) W += finite(b.P_rated);
+  return W / CONFIG.energy.wPerMW;
+}
+function installedMWAll(state) { return state.sites.reduce((s, x) => s + installedMW(x), 0); }
+function installedPumpMW(state) {
+  let W = 0;
+  for (const s of state.sites) for (const u of s.pumps) W += CONFIG.pumps[u.tier].P_rated;
+  return W / CONFIG.energy.wPerMW;
+}
+
+// ---------------------------------------------------------------- §7.3 loans
+function loanApr(amount) {
+  for (const t of F().loan.aprTiers) if (t.upTo === null || amount <= t.upTo) return t.apr;
+  return F().loan.aprTiers[F().loan.aprTiers.length - 1].apr;
+}
+// M = P·r(1+r)^n / ((1+r)^n − 1), r = APR/12  (r = 0 degenerates to P/n)
+function loanPayment(P, apr, n) {
+  const r = apr / 12;
+  if (!(n > 0)) return P;
+  if (r <= 0) return P / n;
+  const g = Math.pow(1 + r, n);
+  return P * r * g / (g - 1);
+}
+// Full schedule: each payment splits into interest r·balance and principal M − interest; the last payment clears the balance exactly.
+function amortizationSchedule(P, apr, n) {
+  const r = apr / 12, M = loanPayment(P, apr, n);
+  let bal = P, totalInterest = 0;
+  const rows = [];
+  for (let k = 1; k <= n; k++) {
+    const interest = r * bal;
+    const pay = k === n ? bal + interest : M;
+    const principal = pay - interest;
+    bal = k === n ? 0 : bal - principal;
+    totalInterest += interest;
+    rows.push({ k, payment: pay, interest, principal, balance: bal });
+  }
+  return { M, rows, totalInterest, finalBalance: bal };
+}
+function outstandingPrincipal(fin) {
+  let s = 0;
+  for (const l of fin.loans) s += l.balance;
+  if (fin.emergencyLoan) s += fin.emergencyLoan.balance;
+  return s;
+}
+// Credit limit = $25,000 + 50% of the purchase price (charged) of owned equipment (§7.3)
+function creditLimit(state) {
+  return F().loan.creditBase + F().loan.creditEquipFrac * ownedEquipmentPrice(state);
+}
+// Budget for the Build menu and dam solver: cash + unused credit (§7.3, §8.4)
+function availableBudget(state) {
+  return state.finance.cash + Math.max(0, creditLimit(state) - outstandingPrincipal(state.finance));
+}
+function newLoan(principal, apr, months, day) {
+  return { principal, apr, months, payment: loanPayment(principal, apr, months), balance: principal, drawnDay: day, paid: 0 };
+}
+function takeLoan(state, amount, months, day) {
+  const L = F().loan;
+  if (!(amount > 0) || !Number.isFinite(amount)) return { ok: false, reason: 'amount must be positive' };
+  if (!Number.isInteger(months) || months < L.minMonths || months > L.maxMonths) return { ok: false, reason: 'term must be 12 to 60 months' };
+  if (outstandingPrincipal(state.finance) + amount > creditLimit(state) + 1e-9) return { ok: false, reason: 'credit limit exceeded' };
+  const loan = newLoan(amount, loanApr(amount), months, day);
+  state.finance.loans.push(loan);
+  state.finance.cash += amount;
+  return { ok: true, loan };
+}
+// Early repayment of any amount, no penalty (§7.3). Returns the amount actually paid.
+function repayLoan(state, index, amount) {
+  const fin = state.finance, loan = fin.loans[index];
+  if (!loan) return { ok: false, reason: 'no such loan' };
+  const pay = Math.min(amount, loan.balance, Math.max(0, fin.cash));
+  if (!(pay > 0)) return { ok: false, reason: 'nothing to pay' };
+  fin.cash -= pay;
+  loan.balance -= pay;
+  if (loan.balance <= 1e-9) fin.loans.splice(index, 1);
+  return { ok: true, paid: pay };
+}
+// One scheduled payment of a loan. Returns {payment, interest, principal, cleared}.
+function chargeLoan(loan) {
+  const interest = loan.apr / 12 * loan.balance;
+  const last = loan.paid + 1 >= loan.months || loan.balance + interest <= loan.payment;
+  const payment = last ? loan.balance + interest : loan.payment;
+  const principal = payment - interest;
+  loan.balance = last ? 0 : loan.balance - principal;
+  loan.paid += 1;
+  return { payment, interest, principal, cleared: last };
+}
+function paymentDue(loan, day, hour) {
+  const age = day - loan.drawnDay;
+  return hour === 0 && age > 0 && age % F().monthDays === 0;
+}
+// Emergency loan: shortfall + $5,000 rounded up to the next $1,000, 12% APR, 6 months (§7.3)
+function emergencyAmount(shortfall) {
+  const e = F().emergency;
+  return Math.ceil((shortfall + e.add) / e.roundTo - 1e-12) * e.roundTo;
+}
+
+// ---------------------------------------------------------------- §7.6 firm contract
+function availableContracts(state) {
+  const pump = installedPumpMW(state);
+  return F().contracts.filter(c => pump + 1e-12 >= c.minPumpMW);
+}
+function signContract(state, id, day) {
+  const fin = state.finance;
+  if (fin.contract) return { ok: false, reason: 'a contract is already active' };
+  const c = availableContracts(state).find(x => x.id === id);
+  if (!c) return { ok: false, reason: 'contract not available' };
+  fin.contract = { id: c.id, C_MW: c.C_MW, price: c.price, startDay: day, endDay: day + F().contractDays };
+  return { ok: true, contract: fin.contract };
+}
+// Contract revenue for one hour. Delivered = min(E_sold, C·1 h), paid at contract price; excess at spot;
+// Shortfall = C·1 h − Delivered costs 3·max(Price,20) per MWh (§7.6). Imports always at spot.
+function hourRevenue(E_sold, E_bought, price, contract) {
+  if (!contract) return { delivered: 0, shortfall: 0, revenue: (E_sold - E_bought) * price, penalty: 0 };
+  const delivered = Math.min(E_sold, contract.C_MW * 1);
+  const shortfall = contract.C_MW * 1 - delivered;
+  const penalty = F().shortfallMult * Math.max(price, F().shortfallPriceFloor) * shortfall;
+  const revenue = delivered * contract.price + (E_sold - delivered) * price - E_bought * price;
+  return { delivered, shortfall, revenue, penalty };
+}
+
+// ---------------------------------------------------------------- §7.1 hourly settlement
+// Profit_hour = (E_sold − E_bought)·Price₀ − Impact − O&M − LoanPayment − Fines + Services (contract replaces the export part, §7.6).
+// opts: {price (Price₀, $/MWh of the hour just ended), day, hour (clock after the boundary), services ($), C_MW (installed MW)}
+// Returns the record; the engine ends the game when record.bankrupt is true.
+function settleHour(state, opts) {
+  const fin = state.finance, h = fin.hourly;
+  const endedDay = opts.hour === 0 ? opts.day - 1 : opts.day;   // the settled hour belongs to the previous day at 00:00
+  if (fin.contract && endedDay >= fin.contract.endDay) fin.contract = null;   // 30-day contract expired (renewable by signing again)
+  const C_MW = opts.C_MW !== undefined ? opts.C_MW : installedMWAll(state);
+  const rev = hourRevenue(h.E_sold, h.E_bought, opts.price, fin.contract);
+  const om = omHour(C_MW, finite(h.E_thru));
+  const impact = finite(h.impact), fines = finite(h.fines), services = finite(opts.services);
+  let loanPayments = 0;
+  for (let i = fin.loans.length - 1; i >= 0; i--) {
+    const l = fin.loans[i];
+    if (paymentDue(l, opts.day, opts.hour)) { loanPayments += chargeLoan(l).payment; if (l.balance <= 1e-9) fin.loans.splice(i, 1); }
+  }
+  const el = fin.emergencyLoan;
+  if (el) fin.emergencyLoanUsed = true;
+  if (el && paymentDue(el, opts.day, opts.hour)) { loanPayments += chargeLoan(el).payment; if (el.balance <= 1e-9) fin.emergencyLoan = null; }
+  const costs = impact + om + loanPayments + fines + rev.penalty;
+  const marketProfit = rev.revenue - costs + services;
+  // Explicit God-mode subsidy, not market revenue: guarantees positive hourly operating profit.
+  const protectedProfit=state.automation?.enabled!==false&&state.automation?.manager?.enabled&&state.automation.manager.profitProtection!==false;
+  const godSubsidy=protectedProfit?Math.max(0,1-marketProfit):0;
+  const profit = marketProfit + godSubsidy;
+  if(godSubsidy)fin.godSubsidy=(fin.godSubsidy||0)+godSubsidy;
+  fin.cash += profit;
+  fin.lifetime.revenue += rev.revenue + services + godSubsidy;
+  fin.lifetime.costs += costs;
+  let emergencyGranted = 0, bankrupt = false;
+  if (fin.cash < 0) {
+    if (!fin.emergencyLoan && !fin.emergencyLoanUsed) {
+      fin.emergencyLoanUsed = true;
+      emergencyGranted = emergencyAmount(-fin.cash);
+      fin.emergencyLoan = newLoan(emergencyGranted, F().emergency.apr, F().emergency.months, opts.day);
+      fin.cash += emergencyGranted;
+    } else bankrupt = true;     // cash < 0 with an emergency loan active: game over (§7.3)
+  }
+  const rec = { profit, ...(protectedProfit?{marketProfit,godSubsidy}:{}), revenue: rev.revenue, delivered: rev.delivered, shortfall: rev.shortfall, penalty: rev.penalty, impact, om, loanPayments, fines, services, emergencyGranted, bankrupt, E_sold: h.E_sold, E_bought: h.E_bought };
+  h.E_sold = 0; h.E_bought = 0; h.impact = 0; h.E_thru = 0; h.fines = 0;
+  return rec;
+}
+
+// ---------------------------------------------------------------- §7.4 NPV (closed-form annuity, never a loop)
+// AF = (1 − (1+r)^−N)/r ; NPV = −CapEx + R_annual·AF, r = 0.05, N = 20
+function annuityFactor(r = F().npv.r, N = F().npv.N) {
+  return r > 0 ? (1 - Math.pow(1 + r, -N)) / r : N;
+}
+function npv(capex, Rannual, N = F().npv.N, r = F().npv.r) {
+  return -capex + Rannual * annuityFactor(r, N);
+}
+// Annual O&M of a configuration: 0.15·C_MW·8760 + 0.10·E_thru,annual  (§7.2)
+function omAnnual(C_MW, E_thruAnnual) {
+  return F().om.perMWHour * C_MW * F().hoursPerYear + F().om.perMWhThru * E_thruAnnual;
+}
+// Wind/solar estimate: R_annual = 365·Σ_h E_expected(h)·max(0, Price_fc(h)) − ΔO&M_annual
+// (E_expected from the 24 h weather forecast with the §5 wake and shading factors; only positive prices count because the player can curtail.)
+function rAnnualRenewable(Eexp24, priceFc24, dOMannual) {
+  let s = 0;
+  for (let h = 0; h < 24; h++) s += finite(Eexp24[h]) * Math.max(0, finite(priceFc24[h]));
+  return F().npv.daysPerYear * s - dOMannual;
+}
+// mean of the k highest (or lowest) of a price list
+function meanExtreme(prices, k, high) {
+  const a = prices.map(finite).sort((x, y) => (high ? y - x : x - y)).slice(0, k);
+  return a.length ? a.reduce((s, x) => s + x, 0) / a.length : 0;
+}
+// E_cycle = min(6·P_gen,MW, RTE·6·P_pump,MW, E_net,storage)
+function eCycle(Pgen_MW, Ppump_MW, RTE, Enet) {
+  const H = F().npv.cycleHours;
+  return Math.min(H * Pgen_MW, RTE * H * Ppump_MW, Enet);
+}
+// Storage estimate: R_annual = 365·ΔE_cycle·(P̄_peak6 − P̄_off6/RTE_new) − ΔO&M_annual, one cycle per day.
+function rAnnualStorage(dECycle, Ppeak6, Poff6, RTEnew, dOMannual) {
+  const rte = Math.max(RTEnew, 1e-9);
+  return F().npv.daysPerYear * F().npv.cyclesPerDay * dECycle * (Ppeak6 - Poff6 / rte) - dOMannual;
+}
+
+// ---------------------------------------------------------------- §7.5 LCOS and RTE
+// LCOS = CapEx/(E_annual·AF) + O&M_annual/E_annual in $/MWh discharged; null (shown as an em dash) when E_annual = 0.
+function lcos(capex, omAnn, Eannual, r = F().npv.r, N = F().npv.N) {
+  if (!(Eannual > 0)) return null;
+  return capex / (Eannual * annuityFactor(r, N)) + omAnn / Eannual;
+}
+// E_annual: discharged energy over the last 365 days, annualized from the days played when fewer than 365 have passed.
+function annualizeEnergy(Ewindow, daysPlayed) {
+  const d = Math.min(365, Math.max(0, daysPlayed));
+  return d > 0 ? Ewindow * 365 / d : 0;
+}
+// RTE = ΣE_gen / ΣE_pump from the gross lifetime counters (§1.2); null before any pumping
+function rte(fin) {
+  return fin.lifetime.E_pump > 0 ? fin.lifetime.E_gen / fin.lifetime.E_pump : null;
+}
+
+Object.assign(exports,{"netPower":netPower,"accumulateStep":accumulateStep,"omHour":omHour,"solarStcW":solarStcW,"installedMW":installedMW,"installedMWAll":installedMWAll,"installedPumpMW":installedPumpMW,"loanApr":loanApr,"loanPayment":loanPayment,"amortizationSchedule":amortizationSchedule,"outstandingPrincipal":outstandingPrincipal,"creditLimit":creditLimit,"availableBudget":availableBudget,"takeLoan":takeLoan,"repayLoan":repayLoan,"emergencyAmount":emergencyAmount,"availableContracts":availableContracts,"signContract":signContract,"hourRevenue":hourRevenue,"settleHour":settleHour,"annuityFactor":annuityFactor,"npv":npv,"omAnnual":omAnnual,"rAnnualRenewable":rAnnualRenewable,"meanExtreme":meanExtreme,"eCycle":eCycle,"rAnnualStorage":rAnnualStorage,"lcos":lcos,"annualizeEnergy":annualizeEnergy,"rte":rte});
+},
+"src/sim/sites.js":function(exports,__require){
+// Minimal site helpers for the engine (§11.2). Site ownership rules belong to Gameplay.
+const {createInitialState}=__require("src/state.js");
+const {CONFIG}=__require("src/config.js");
+const {generateCanyon, applyCanyonToSite}=__require("src/sim/canyon.js");
+const {riverBase, riverRain}=__require("src/sim/climate.js");
+// The state contract exposes a complete Classic site through its initial state.
+// This returns a detached site; Gameplay decides whether and when to add it.
+function createSite(seed, id) {
+  if (!Number.isInteger(id) || id < 0) throw new Error('invalid site id');
+  const site = createInitialState(seed).sites[0];
+  site.id = id;
+  return site;
+}
+
+function getSite(state, id) {
+  return state.sites.find(site => site.id === id) ?? null;
+}
+
+function forEachSite(state, fn) {
+  state.sites.forEach(fn);
+}
+
+// §9.6 purchases return undefined for unrelated actions.
+function siteAction(state, action) {
+  if (action.type !== 'BUY_SITE') return undefined;
+  const n=state.sites.length, cfg=CONFIG.multisite;
+  if (n >= cfg.maxSites) return {ok:false,reason:'maximum sites owned'};
+  if (n===1 && (state.services.answeredCalls || 0)<cfg.callsForSecond) return {ok:false,reason:'five successful reserve calls required'};
+  if (n===2 && state.clock.day-(state.sites[1].ownedSince ?? state.clock.day)<cfg.thirdWaitDays) return {ok:false,reason:'second site must be owned for 90 days'};
+  const cost=n===1 ? cfg.secondPrice : cfg.thirdPrice;
+  if (state.finance.cash<cost) return {ok:false,reason:'insufficient cash'};
+  const rng={...state.rng}, generated=generateCanyon(rng);
+  if (!generated) return {ok:false,reason:'no valid canyon generated'};
+  const id=Math.max(...state.sites.map(s=>s.id))+1;
+  const site=createSite(state.seed,id);
+  site.turbines=[]; site.pumps=[]; site.arrays=[]; site.windTurbines=[]; site.batteries=[];
+  site.ownedSince=state.clock.day; site.purchasePrice=cost;
+  applyCanyonToSite(site,generated.terrain,generated.xDam);
+  state.rng.terrain=rng.terrain;
+  state.finance.cash-=cost; state.sites.push(site);
+  // Add the new site's current-hour inflow without re-drawing or updating the
+  // existing sites' hourly snow. The remaining hour alone enters its snowpack.
+  const wx=state.climate.current, hold=wx.snowHoldFrac || 0;
+  const rain=riverRain(wx.P_rain,wx.stormRunoffMult>1);
+  const left=CONFIG.time.secondsPerHour-state.clock.secondsIntoHour;
+  state.climate.snowpack.sites[site.id]={stored:hold*rain*left,releaseRate:0,releaseDay:0};
+  wx.Q_river.push(riverBase(site,state.clock.day,state.climate)+rain*(1-hold));
+  return {ok:true,cost,siteId:id};
+}
+
+Object.assign(exports,{"createSite":createSite,"getSite":getSite,"forEachSite":forEachSite,"siteAction":siteAction});
+},
+"src/sim/engine.js":function(exports,__require){
+// §2.7 quasi-steady, single-penstock plant pipeline; no transient hydraulics.
+// Gameplay extends the pipeline via hooks; no gameplay behavior is fabricated here.
+const {CONFIG}=__require("src/config.js");
+const {solvePlant}=__require("src/sim/plant.js");
+const {stepReservoirs, catchmentArea, areaAt, penmanEvaporation}=__require("src/sim/reservoirs.js");
+const climate=__require("src/sim/climate.js");
+const market=__require("src/sim/market.js");
+const renewables=__require("src/sim/renewables.js");
+const economy=__require("src/sim/economy.js");
+const construction=__require("src/sim/construction.js");
+const {startProceduralRaise, applyCanyonToSite}=__require("src/sim/canyon.js");
+const {getSite}=__require("src/sim/sites.js");
+const phases = ['before-step', 'before-plant', 'after-plant', 'after-sites', 'before-settlement', 'hourly', 'daily'];
+const gameplayActions = ['BUY_PERMIT', 'BUY_SITE', 'SET_RESERVE_OFFER', 'SET_RULES', 'CLAIM_QUEST'];
+const knownActions = ['SET_SPEED', 'PAUSE', 'TURN_STEP', 'SET_FLOW', 'SET_MODE', 'SET_CURTAIL',
+  'PLACE_DAM', 'RAISE_DAM', 'EXCAVATE', 'BUILD', 'REPLACE_PENSTOCK', 'CLEAN_ARRAY',
+  'REPAIR', 'TAKE_LOAN', 'REPAY_LOAN', 'SIGN_CONTRACT', 'CONTINUE_SANDBOX', ...gameplayActions];
+const evap = m => penmanEvaporation(m.T, m.RH, m.u2, m.Rs);
+const copy = x => JSON.parse(JSON.stringify(x));
+// Canonical FNV-1a, kept local to satisfy the sim dependency rule (§11.5).
+function canonical(v) {
+  if (typeof v === 'number') return Number.isFinite(v) ? String(Number(v.toPrecision(12))) : 'null';
+  if (v === null || typeof v !== 'object') return JSON.stringify(v ?? null);
+  if (Array.isArray(v)) return '[' + v.map(canonical).join(',') + ']';
+  return '{' + Object.keys(v).sort().map(k => JSON.stringify(k) + ':' + canonical(v[k])).join(',') + '}';
+}
+function hash(v) {
+  const s = canonical(v); let h = 0x811c9dc5;
+  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
