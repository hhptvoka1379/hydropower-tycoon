+"src/sim/reservoirs.js":function(exports,__require){
+// Reservoirs and mass conservation (§3). Pure functions, SI units.
+// A reservoir is either a frustum {A_bot, s, D_max, z_floor, V_max, V, d, z}
+// or tabulated (same fields plus `table: {h, A:[...], V:[...]}`) (§3.1).
+const {CONFIG}=__require("src/config.js");
+const {frustumArea, frustumVolume}=__require("src/state.js");
+const RC = CONFIG.reservoir;
+const PM = CONFIG.penman;
+
+// ---- Tabulated form (§3.1) ----
+// Build A_k = A(k·h) with A_k ≥ A_min, non-decreasing, and cumulative V_k (exact for linear A).
+function buildTable(areaFn, D_max, h = RC.tableStep) {
+  const n = Math.max(1, Math.ceil(D_max / h - 1e-9));
+  const A = [], V = [0];
+  for (let k = 0; k <= n; k++) {
+    let a = Math.max(RC.A_min, areaFn(Math.min(k * h, D_max)));
+    if (k > 0 && a < A[k - 1]) throw new Error('tabulated area must be non-decreasing (§3.1)');
+    A.push(a);
+    if (k > 0) V.push(V[k - 1] + (A[k - 1] + a) / 2 * h);  // trapezoid = exact quadratic integral
+  }
+  return { h, A, V };
+}
+function segOf(t, d) { return Math.min(t.A.length - 2, Math.max(0, Math.floor(d / t.h))); }
+// V(d) = V_k + A_k u + (A_{k+1} − A_k)/(2h) u² (§3.1)
+function tabVolume(t, d) {
+  const k = segOf(t, d), u = d - k * t.h;
+  return t.V[k] + t.A[k] * u + (t.A[k + 1] - t.A[k]) / (2 * t.h) * u * u;
+}
+function tabArea(t, d) {
+  const k = segOf(t, d), u = d - k * t.h;
+  return t.A[k] + (t.A[k + 1] - t.A[k]) * u / t.h;
+}
+
+// Common interface A(d), V(d) (§3.1)
+function areaAt(res, d) {
+  return res.table ? tabArea(res.table, d) : frustumArea(res.A_bot, res.s, d);
+}
+function volumeAt(res, d) {
+  return res.table ? tabVolume(res.table, d) : frustumVolume(res.A_bot, res.s, d);
+}
+function maxVolume(res) { return volumeAt(res, res.D_max); }
+
+// Depth from volume: Newton–Raphson with V'(d) = A(d), start at previous depth,
+// tol 1e-6 m³, hard cap 8 iterations, clamp to [0, D_max] (§3.1). Tabulated: stay in the
+// current segment, hop to the neighbour when the root lies outside it.
+function dFromV(res, V, dPrev = res.d ?? 0) {
+  const Vmax = maxVolume(res);
+  if (!(V > 0)) return 0;
+  if (V >= Vmax) return res.D_max;
+  if (res.table) {
+    const t = res.table;
+    let k = segOf(t, Math.min(Math.max(dPrev, 0), res.D_max));
+    while (k > 0 && V < t.V[k]) k--;                      // move to neighbouring segment
+    while (k < t.A.length - 2 && V > t.V[k + 1]) k++;
+    const lo = k * t.h, hi = Math.min((k + 1) * t.h, res.D_max);
+    let d = Math.min(hi, Math.max(lo, dPrev));
+    for (let i = 0; i < RC.newtonMaxIter; i++) {
+      const r = tabVolume(t, d) - V;
+      if (Math.abs(r) < RC.newtonTol) break;
+      const A = tabArea(t, d);
+      d = Math.min(hi, Math.max(lo, d - (A > 0 ? r / A : 0)));
+    }
+    return Math.min(res.D_max, Math.max(0, d));
+  }
+  let d = Math.min(res.D_max, Math.max(0, dPrev));
+  if (d === 0) d = res.D_max * V / Vmax;                  // avoid A(0)-only start from empty
+  for (let i = 0; i < RC.newtonMaxIter; i++) {
+    const r = frustumVolume(res.A_bot, res.s, d) - V;
+    if (Math.abs(r) < RC.newtonTol) break;
+    const A = frustumArea(res.A_bot, res.s, d);
+    d = Math.min(res.D_max, Math.max(0, d - (A > 0 ? r / A : 0)));
+  }
+  return d;
+}
+
+// A_catch = 2·A_lower(D_max), fixed at game start (§3.2)
+function catchmentArea(lower) { return RC.catchFactor * areaAt(lower, lower.D_max); }
+
+// Flow interlock (§3.2): limit Q_pen so no reservoir over/under-flows in one step.
+// mode 'pump' | 'gen'. Returns {limit, factor} where factor scales every unit's flow.
+function interlockLimit(mode, Q_pen, upper, lower, dt) {
+  if (!(Q_pen > 0) || !(dt > 0)) return { limit: 0, factor: Q_pen > 0 ? 0 : 1 };
+  const src = mode === 'pump' ? lower : upper, dst = mode === 'pump' ? upper : lower;
+  const limit = Math.max(0, Math.min(src.V / dt, (dst.V_max - dst.V) / dt));
+  return { limit, factor: Q_pen > limit ? limit / Q_pen : 1 };
+}
+
+// Mass balance, spill and release for one step (§3.2). Mutates V, d, z of both reservoirs.
+// inp: {Q_up, P_rain, E_evap (mm/day), Q_river, Q_river_base (m³/s), dV_melt (m³),
+//       A_catch (m²), Q_env (m³/s)}. Returns spill/fine volumes for Economy and alerts.
+function stepReservoirs(upper, lower, inp, dt) {
+  const Q_up = inp.Q_up || 0, rain = inp.P_rain || 0, evap = inp.E_evap || 0;
+  const Q_river = inp.Q_river || 0;
+  const A_up = areaAt(upper, upper.d), A_lo = areaAt(lower, lower.d);  // A at step start
+  const netMm = (rain - evap) / 1000 * dt / 86400;                       // mm/day → m per step
+  // ΔV_runoff = (P_rain/1000)·max(0, A_catch − A_lower)·0.25·dt/86400 (§3.2)
+  const dV_runoff = rain / 1000 * Math.max(0, (inp.A_catch || 0) - A_lo) * RC.runoffCoef * dt / 86400;
+  // 1. upper: ΔV_upper = Q_up dt + A_up (P−E)/1000 dt/86400 + Q_river dt
+  let Vu = upper.V + Q_up * dt + A_up * netMm + Q_river * dt;
+  let S_upper = 0;
+  if (Vu > upper.V_max) { S_upper = Vu - upper.V_max; Vu = upper.V_max; }   // spill, not fined
+  // 2. lower: ΔV_lower = −Q_up dt + A_lo (P−E)/1000 dt/86400 + ΔV_runoff + ΔV_melt + S_upper − release
+  let Vl = lower.V - Q_up * dt + A_lo * netMm + dV_runoff + (inp.dV_melt || 0) + S_upper;
+  const envWanted = Math.max(0, inp.Q_env || 0) * dt;
+  const envReleased = Math.min(envWanted, Math.max(0, Vl));                // sink limited to water available
+  Vl -= envReleased;
+  let S_lower = 0;
+  if (Vl > lower.V_max) { S_lower = Vl - lower.V_max; Vl = lower.V_max; }
+  // 3. Fined flood part (approximation: base river flow is treated as passing straight through)
+  const finedVolume = Math.max(0, S_lower - (inp.Q_river_base || 0) * dt);
+  // 4. Guard V ≥ 0, recompute depths by Newton inversion
+  upper.V = Math.max(0, Vu); lower.V = Math.max(0, Vl);
+  upper.d = dFromV(upper, upper.V, upper.d); upper.z = upper.z_floor + upper.d;
+  lower.d = dFromV(lower, lower.V, lower.d); lower.z = lower.z_floor + lower.d;
+  return { S_upper, S_lower, finedVolume, envReleased, envUnmet: envWanted - envReleased, dV_runoff };
+}
+
+// Penman 1948 open-water evaporation (§3.3), mm/day. Verbatim, NO FAO-56 (1+0.34u₂) term.
+function penmanEvaporation(T, RH, u2, Gbar) {
+  if (T < 0) return 0;                                              // ice cover
+  const Tc = Math.max(T, -200);
+  const es = PM.a * Math.exp(Math.min(PM.b * Tc / (Tc + PM.c), 50)); // e_s(T)
+  const Delta = PM.dA * es / ((Tc + PM.c) ** 2);                    // Δ
+  const ea = Math.min(Math.max(RH, 0), 1) * es;                     // e_a = RH·e_s
+  const g = PM.gamma;
+  const Rs = PM.Rs_per_W * Math.max(Gbar, 0);                       // R_s = 0.0864 Ḡ
+  const Rn = PM.albedoFactor * Rs;                                  // R_n = 0.92 R_s
+  const E = PM.k_rad * Delta * Rn / (Delta + g)
+    + g / (Delta + g) * PM.k_aero * Math.max(u2, 0) * (es - ea) / (Tc + 273);
+  return Math.max(0, E);
+}
+
+// Stored energy (§12 Test 11): E = ρ g V H / 3.6e9 MWh
+function storedEnergyMWh(V, H, eta = 1) {
+  return CONFIG.physics.rho * CONFIG.physics.g * V * Math.max(H, 0) * eta / 3.6e9;
+}
+
+Object.assign(exports,{"buildTable":buildTable,"areaAt":areaAt,"volumeAt":volumeAt,"maxVolume":maxVolume,"dFromV":dFromV,"catchmentArea":catchmentArea,"interlockLimit":interlockLimit,"stepReservoirs":stepReservoirs,"penmanEvaporation":penmanEvaporation,"storedEnergyMWh":storedEnergyMWh});
+},
+"src/sim/canyon.js":function(exports,__require){
+// §8.3 / §8.4 Procedural canyon: value-noise terrain from the `terrain` stream, A(d) table, dam concrete integral,
+// raise cost, the three dam solvers, siting preview, generator with validity retries. Pure; no DOM.
+// Units: x, W, s, h in m; areas m²; volumes m³; money $ (charged = base × CAPEX_SCALE, concrete $12/m³).
+const {CONFIG}=__require("src/config.js");
+const {nextFloat, makeGenerator}=__require("src/rng.js");
+const {buildTable, dFromV}=__require("src/sim/reservoirs.js");
+const CN = () => CONFIG.canyon;
+const clamp = (x, lo, hi) => Math.min(hi, Math.max(lo, x));
+
+// ---------------------------------------------------------------- 1-D value noise
+// One lattice per wavelength, values uniform in [−1,1] from a generator seeded by the sub-seed drawn from the terrain stream.
+const latticeCache = new Map();
+function lattice(subSeed, octaveKey, n) {
+  const key = subSeed + ':' + octaveKey + ':' + n;
+  let L = latticeCache.get(key);
+  if (!L) {
+    const g = makeGenerator((subSeed ^ Math.imul(octaveKey + 1, 0x9E3779B1)) >>> 0);
+    L = new Float64Array(n);
+    for (let i = 0; i < n; i++) L[i] = 2 * g() - 1;
+    if (latticeCache.size > 64) latticeCache.clear();
+    latticeCache.set(key, L);
+  }
+  return L;
+}
+// Smooth value noise at wavelength lam: smoothstep interpolation between lattice values.
+function valueNoise(subSeed, octaveKey, lam, x) {
+  const n = Math.ceil(CN().length / lam) + 2;
+  const L = lattice(subSeed, octaveKey, n);
+  const u = Math.max(0, x) / lam, i = Math.floor(u), t = u - i;
+  const w = t * t * (3 - 2 * t);
+  return L[i % n] * (1 - w) + L[(i + 1) % n] * w;
+}
+// Weighted sum normalised by Σ weights, so the result lies in [−1,1] (§8.3).
+function fbm(subSeed, base, spec, x) {
+  let s = 0, wsum = 0;
+  for (let k = 0; k < spec.wavelengths.length; k++) {
+    s += spec.weights[k] * valueNoise(subSeed, base + k, spec.wavelengths[k], x);
+    wsum += spec.weights[k];
+  }
+  return s / wsum;
+}
+const Nw = (t, x) => fbm(t.subSeed, 0, CN().Nw, x);    // wavelengths 400, 150, 50 m, weights 1, 0.5, 0.25
+const Ns = (t, x) => fbm(t.subSeed, 10, CN().Ns, x);   // wavelengths 300, 100 m, weights 1, 0.5
+
+// Terrain parameter record (stored as site.terrain); the terrain bias menu edits W0, a_w, s0, a_s, S0 (§8.3).
+function makeTerrain(subSeed, overrides = {}) {
+  const c = CN();
+  return { subSeed, W0: c.W0, a_w: c.a_w, s0: c.s0, a_s: c.a_s, S0: c.S0, ...overrides };
+}
+// W_bot(x) = clamp(W0(1 + a_w N_w(x)), 12, 200)   s(x) = clamp(s0 + a_s N_s(x), 0.35, 1.5)
+function Wbot(t, x) { const c = CN(); return clamp(t.W0 * (1 + t.a_w * Nw(t, x)), c.Wbot_min, c.Wbot_max); }
+function slope(t, x) { const c = CN(); return clamp(t.s0 + t.a_s * Ns(t, x), c.s_min, c.s_max); }
+// Presentation centreline only: a seeded meander, anchored at the dam and lower basin.
+// It shifts cross-sections laterally without altering their widths or physical volumes.
+function canyonOffset(t, xDam, x) {
+  const phase=(t.subSeed%997)/997*Math.PI*2;
+  // The river's shape is anchored to absolute canyon coordinates, not to the
+  // chosen dam. Re-centering at a new station translates the same bends.
+  const curve=u=>(90+20*Math.sin(phase))*Math.sin(u/480+phase)+38*Math.sin(u/205+phase*.7)+14*Math.sin(u/95+phase*1.3);
+  return curve(x)-curve(xDam);
+}
+// z_bed(x) = z_upper_floor + S0 (x − x_dam)
+function zBed(t, zUpperFloor, xDam, x) { return zUpperFloor + t.S0 * (x - xDam); }
+
+// ---------------------------------------------------------------- A(d) and tables
+// A(d) = ∫ from x_dam (W_bot + 2 s h) dx, h(x) = d − S0 (x − x_dam), counted only where h > 0; midpoint rule with step dx.
+function areaAtDepth(t, xDam, d, dx = CN().dx) {
+  if (!(d > 0)) return 0;
+  const reach = d / t.S0;                       // x_back − x_dam where h reaches 0
+  const n = Math.ceil(Math.min(reach, CN().length) / dx);
+  let A = 0;
+  for (let i = 0; i < n; i++) {
+    const xm = xDam + (i + 0.5) * dx;
+    const h = d - t.S0 * (xm - xDam);
+    if (h > 0) A += (Wbot(t, xm) + 2 * slope(t, xm) * h) * dx;
+  }
+  return A;
+}
+// Table of A at d = 0, step, 2·step … up to the dam height, in the §3.1 form {h, A[], V[]} (A linear per step, V piecewise quadratic).
+function buildCanyonTable(t, xDam, Hdam, fine = true) {
+  const c = CN();
+  const dx = fine ? c.dx : c.previewDx, step = fine ? c.depthStep : c.previewDepthStep;
+  return buildTable(d => areaAtDepth(t, xDam, d, dx), Hdam, step);
+}
+function tableVmax(table) { return table.V[table.V.length - 1]; }
+function vmaxAt(t, xDam, H, fine = true) { return tableVmax(buildCanyonTable(t, xDam, H, fine)); }
+
+// ---------------------------------------------------------------- dam concrete and cost
+// V_conc(H) = ∫0^H (W_bot(x_dam) + 2 s(x_dam) y)(t_crest + k_batter (H − y)) dy, 100 midpoint steps (§8.4)
+function concreteVolume(Wb, s, H, cls) {
+  const prof = CONFIG.dam.profile[cls], N = CONFIG.dam.concreteIntegralSteps;
+  const dy = H / N;
+  let V = 0;
+  for (let i = 0; i < N; i++) {
+    const y = (i + 0.5) * dy;
+    V += (Wb + 2 * s * y) * (prof.t_crest + prof.k_batter * (H - y)) * dy;
+  }
+  return V;
+}
+function concretePricePerM3() { return CONFIG.dam.concreteBasePricePerM3 * CONFIG.CAPEX_SCALE; }   // $300 × 0.04 = $12
+// Cost_dam(H) = 12·V_conc(H)
+function damCost(Wb, s, H, cls) { return concretePricePerM3() * concreteVolume(Wb, s, H, cls); }
+function damCostAt(t, xDam, H, cls) { return damCost(Wbot(t, xDam), slope(t, xDam), H, cls); }
+// Raising from H_cur to H pays Cost_dam(H) − Cost_dam(H_cur), takes 2 + (H − H_cur)/5 days (§8.4)
+function raiseCost(Wb, s, Hcur, H, cls) { return damCost(Wb, s, H, cls) - damCost(Wb, s, Hcur, cls); }
+function raiseDays(Hcur, H) { return CONFIG.dam.raiseDaysBase + (H - Hcur) * CONFIG.dam.raiseDaysPerM; }
+function classLimit(cls) { return CONFIG.dam.classMaxHdam[cls]; }
+
+// ---------------------------------------------------------------- solvers (§8.4)
+// (2) Max volume for budget B: H* = max{H integer, H_cur ≤ H ≤ class limit : raise cost ≤ B}. Cost is strictly increasing in H, so bisection.
+function solveMaxHeightForBudget(Wb, s, Hcur, cls, B) {
+  const lim = classLimit(cls);
+  if (Hcur >= lim) return { H: Hcur, cost: 0 };
+  let lo = Hcur, hi = lim;                       // invariant: cost(lo) ≤ B
+  if (raiseCost(Wb, s, Hcur, hi, cls) <= B) lo = hi;
+  while (hi - lo > 1) {
+    const mid = Math.floor((lo + hi) / 2);
+    if (raiseCost(Wb, s, Hcur, mid, cls) <= B) lo = mid; else hi = mid;
+  }
+  return { H: lo, cost: raiseCost(Wb, s, Hcur, lo, cls) };
+}
+// Usable net energy of a dam of height H (MWh): limited by the smaller reservoir, min(V_upper, V_lower,max) (§8.4).
+// E = ρ g V H_g η_t / 3.6e9 with H_g ≈ 40 m + H_dam (§8.4).
+function usableEnergy(Vupper, VlowerMax, H, eta_t, grossHead) {
