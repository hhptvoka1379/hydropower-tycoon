+      state.alerts.push({type:'dam_crack',severity:'danger',siteId:site.id,day:state.clock.day,hour:state.clock.hour,depth});
+    }
+  }
+  if(dam.crack && site.reservoirs.upper.d>dam.crack.depth) {
+    const rate=storm?cfg.stormWearPerDay:cfg.wearPerDay;
+    dam.crack.wear=Math.min(1,dam.crack.wear+rate*dt/(CONFIG.time.hoursPerDay*CONFIG.time.secondsPerHour));
+  }
+}
+export function damSafeVolume(site) { return site.dam.crack ? volumeAt(site.reservoirs.upper,site.dam.crack.depth) : site.reservoirs.upper.V_max; }
+export function damRepairCost(site) {
+  const dam=site.dam;
+  const value=site.kind==='procedural'?damCostAt(site.terrain,dam.station,dam.H_dam,dam.class):CONFIG.dam.C_dam*CONFIG.CAPEX_SCALE*dam.H_gross*dam.H_gross;
+  return value*CONFIG.damDamage.repairFraction;
