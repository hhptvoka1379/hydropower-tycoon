+}
+
+export function batteryStep({site,dt,totals}) {
+  for (const b of site.batteries) {
+    const power = stepBattery(b,dt);
+    totals.P_bat_ch += power.P_bat_ch;
+    totals.P_bat_dis += power.P_bat_dis;
+  }
+}
